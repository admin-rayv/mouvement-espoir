---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { languages, routes, path, type Lang, type RouteKey } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  /** Image de hero à précharger (LCP) */
  preloadImage?: string;
  /** Page utilitaire : exclue des moteurs de recherche */
  noindex?: boolean;
  /** Libellé de la page dans le fil d'Ariane (absent = pas de fil d'Ariane) */
  breadcrumb?: string;
  /** Données structurées supplémentaires propres à la page */
  schema?: unknown;
  /** Langue de la page */
  lang?: Lang;
  /** Clé de route : permet de générer les liens hreflang vers l'autre langue */
  routeKey?: RouteKey;
}

const {
  title,
  description,
  preloadImage,
  noindex = false,
  breadcrumb,
  schema,
  lang = 'fr',
  routeKey,
} = Astro.props;

const t = ui[lang];

const defaultDescription = {
  fr: "OBNL québécois entièrement bénévole : 100 % des revenus nets de nos activités-bénéfice financent la recherche sur la guérison de la sclérose en plaques.",
  en: "An all-volunteer Quebec non-profit: 100% of the net proceeds from our fundraising events go to research toward a cure for multiple sclerosis.",
}[lang];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/images/og-image.jpg', Astro.site);

// Liens de langue : chaque page connaît son équivalent dans l'autre langue
const alternates = routeKey
  ? (Object.keys(languages) as Lang[]).map((l) => ({
      lang: l,
      hreflang: languages[l].htmlLang,
      href: new URL(path(routeKey, l), Astro.site).toString(),
    }))
  : [];

const orgSchema = {
  fr: {
    description:
      "Organisme à but non lucratif québécois qui organise des activités-bénéfice dont 100 % des revenus nets financent la recherche sur la guérison de la sclérose en plaques.",
    slogan: "Financer. Chercher. Guérir la sclérose en plaques.",
    knowsAbout: ["Sclérose en plaques", "Recherche médicale", "Financement de la recherche", "Activités-bénéfice", "Bénévolat"],
    president: "Fondatrice et présidente",
    cofounder: "Cofondatrice",
    home: "Accueil",
  },
  en: {
    description:
      "A Quebec non-profit organization that runs fundraising events whose net proceeds go entirely to research toward a cure for multiple sclerosis.",
    slogan: "Fund. Research. Cure multiple sclerosis.",
    knowsAbout: ["Multiple sclerosis", "Medical research", "Research funding", "Fundraising events", "Volunteering"],
    president: "Founder and President",
    cofounder: "Co-founder",
    home: "Home",
  },
}[lang];

const organisation = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "Mouvement solidaire eSPoir",
  url: new URL(path('home', lang), Astro.site).toString(),
  logo: new URL('/images/logo-mouvement-solidaire-espoir.png', Astro.site).toString(),
  description: orgSchema.description,
  email: "info@msespoir.com",
  foundingDate: "2025-10",
  inLanguage: ["fr-CA", "en-CA"],
  address: {
    "@type": "PostalAddress",
    streetAddress: "243, boul. Brien, bureau 250",
    addressLocality: "Repentigny",
    addressRegion: "QC",
    postalCode: "J6A 6M4",
    addressCountry: "CA",
  },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Québec" },
    { "@type": "AdministrativeArea", name: "Lanaudière" },
  ],
  knowsAbout: orgSchema.knowsAbout,
  slogan: orgSchema.slogan,
  nonprofitStatus: "NonprofitANBI",
  identifier: {
    "@type": "PropertyValue",
    name: "NEQ (Registraire des entreprises du Québec)",
    value: "1181440711",
  },
  founder: [
    { "@type": "Person", name: "Marie-Carole Daigle", jobTitle: orgSchema.president },
    { "@type": "Person", name: "Hélène Collette", jobTitle: orgSchema.cofounder },
  ],
  sameAs: ["https://www.facebook.com/people/Mouvement-solidaire-espoir/61574511753846/"],
};

// Fil d'Ariane : Accueil > page courante
const breadcrumbSchema = breadcrumb && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: orgSchema.home,
      item: new URL(path('home', lang), Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: breadcrumb,
      item: canonicalURL.toString(),
    },
  ],
};
---

<!DOCTYPE html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description ?? defaultDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1B3A5F" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Versions linguistiques -->
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={new URL(path(routeKey!, 'fr'), Astro.site).toString()} />
    )}

    <!-- Polices auto-hébergées : Montserrat (titres) + Inter (corps) -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/montserrat-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!-- Open Graph -->
    <meta property="og:site_name" content="Mouvement solidaire eSPoir" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? defaultDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {alternates.filter((a) => a.lang !== lang).map((a) => (
      <meta property="og:locale:alternate" content={languages[a.lang].ogLocale} />
    ))}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Deux mains qui se tiennent — Mouvement solidaire eSPoir" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? defaultDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <ClientRouter />
  </head>
  <body>
    <a href="#contenu" class="skip-link">{t.skipLink}</a>
    <slot />
  </body>
</html>

<script>
  /* ---------- Animations au défilement ---------- */
  let observer: IntersectionObserver | null = null;

  function initReveal() {
    observer?.disconnect();
    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer?.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
    );
    document.querySelectorAll('[data-animate]').forEach((el) => observer?.observe(el));
  }

  /* ---------- Compteurs (ex. : 100 %) ---------- */
  function initCounters() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    if (!counters.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          io.unobserve(el);
          const target = Number(el.dataset.count ?? '0');
          if (reduce) {
            el.textContent = String(target);
            return;
          }
          const duration = 2600;
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 4);
            el.textContent = String(Math.round(target * eased));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      },
      { threshold: 0.4 },
    );
    counters.forEach((el) => io.observe(el));
  }

  /* ---------- En-tête : état au défilement ---------- */
  let lastY = 0;

  function updateHeader() {
    const header = document.getElementById('header');
    if (!header) return;
    const y = window.scrollY;
    header.classList.toggle('scrolled', y > 60);
    const menuOpen = header.classList.contains('menu-open');
    header.classList.toggle('is-hidden', !menuOpen && y > 320 && y > lastY + 4);
    if (y < lastY - 4 || y <= 320) header.classList.remove('is-hidden');
    lastY = y;
  }

  window.addEventListener('scroll', updateHeader, { passive: true });

  function init() {
    lastY = window.scrollY;
    updateHeader();
    initReveal();
    initCounters();
  }

  document.addEventListener('astro:page-load', init);
</script>
