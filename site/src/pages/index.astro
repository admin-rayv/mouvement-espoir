---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Mouvement solidaire eSPoir — Financer. Chercher. Guérir la sclérose en plaques."
  description="Mouvement solidaire eSPoir : OBNL québécois entièrement bénévole. 100 % des revenus nets de nos activités-bénéfice financent la recherche sur la guérison de la sclérose en plaques."
  preloadImage="/images/hero-home.jpg">
  <Header />

  <main id="contenu">
    <PageHero
      tall
      image="/images/hero-home.jpg"
      label='Mouvement solidaire e<span class="sp-emphasis">SP</span>oir'
      lines={['Financer.', 'Chercher.', '<em>Guérir</em> la sclérose en plaques.']}
      description="Nous organisons des activités, culturelles et autres, afin de rassembler la communauté autour d'une cause porteuse d'espoir&#8239;: la guérison de la sclérose en plaques. Les fonds ainsi recueillis sont entièrement consacrés au soutien de projets de recherche menés par des équipes reconnues pour leur expertise de pointe dans le domaine."
      meta={['Repentigny · Lanaudière', 'OBNL entièrement bénévole', 'Fondé en octobre 2025']}
    />

    <!-- ========== IMPACT ========== -->
    <section class="impact" id="intro">
      <div class="container">
        <div class="impact-grid">
          <div class="impact-number" data-animate>
            <span class="text-huge"><span data-count="100">100</span>&#8239;%</span>
          </div>
          <div class="impact-content" data-animate data-delay="2">
            <p class="text-display">
              de votre don finance<br/>
              directement la recherche
            </p>
            <div class="divider"></div>
            <p class="text-muted">
              Aucuns frais administratifs. Tout notre travail est bénévole.
              Chaque dollar dégagé par nos activités-bénéfice va à la recherche.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== MISSION ========== -->
    <section class="mission">
      <div class="container">
        <div class="mission-grid">
          <div class="mission-visual frame-offset" data-animate="reveal">
            <div class="mission-image image-frame">
              <img src="/images/equipe-benevoles-mouvement-solidaire-espoir.jpg" alt="L'équipe de bénévoles du Mouvement solidaire eSPoir réunie autour du logo" width="1280" height="960" loading="lazy" decoding="async" />
            </div>
          </div>

          <div class="mission-content" data-animate data-delay="2">
            <span class="text-label">Notre mission</span>
            <h2>Financer.<br/>Chercher.<br/>Guérir la sclérose en plaques.</h2>

            <p>
              La sclérose en plaques touche directement 20 000 personnes au Québec.
              Dans la région de Lanaudière où se trouvent actuellement nos bureaux,
              environ 1 300 d'entre elles vivent avec cette maladie.
            </p>
            <p>
              Le Mouvement solidaire eSPoir organise des événements culturels
              dont tous les bénéfices sont dirigés vers la recherche sur la
              guérison de la sclérose en plaques.
            </p>

            <a href="/histoire" class="link-underline">
              Découvrir notre histoire
              <span class="arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== APPROACH ========== -->
    <section class="approach">
      <div class="container">
        <header class="section-head" data-animate>
          <span class="text-label">Notre approche</span>
          <h2>Ensemble, nous allons<br/>contribuer à changer les choses&#8239;!</h2>
        </header>

        <div class="num-list approach-items">
          <article class="num-item" data-animate data-delay="1">
            <span class="num-index">01</span>
            <h3>Événements culturels</h3>
            <p>
              Spectacles, soupers-bénéfice, activités culturelles.
              Des rassemblements qui unissent la communauté.
            </p>
          </article>

          <article class="num-item" data-animate data-delay="2">
            <span class="num-index">02</span>
            <h3>Transparence totale</h3>
            <p>
              100&#8239;% des bénéfices vont à la recherche.
              Zéro frais administratifs. Notre secret : de généreux bénévoles.
            </p>
          </article>

          <article class="num-item" data-animate data-delay="3">
            <span class="num-index">03</span>
            <h3>Recherche de pointe</h3>
            <p>
              Nos fonds sont destinés à soutenir des projets menés par
              des chercheurs reconnus pour leur expertise.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== EVENT ========== -->
    <section class="event">
      <div class="container">
        <div class="event-wrapper">
          <div class="event-content" data-animate>
            <span class="text-label">Prochain événement</span>
            <h2>On vous prépare<br/>quelque chose pour bientôt&#8239;!</h2>
            <p>
              Spectacles, soupers-bénéfice et activités
              familiales partout au Québec.
            </p>
            <a href="#newsletter" class="btn btn-secondary">
              Être informé
              <span class="btn-arrow">→</span>
            </a>
          </div>
          <div class="event-visual frame-offset" data-animate="reveal" data-delay="1">
            <div class="event-image image-frame">
              <img src="/images/mc-parle.jpg" alt="Marie-Carole Daigle s'adresse à la communauté lors d'un événement-bénéfice" width="1600" height="1200" loading="lazy" decoding="async" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== PARTENAIRES ========== -->
    <section class="partners">
      <div class="container">
        <header class="section-head" data-animate>
          <span class="text-label">Nos partenaires</span>
          <h2>Ils soutiennent<br/>notre mission</h2>
        </header>

        <div class="partners-grid" data-animate data-delay="1">
          <div class="partner-item">
            <img src="/images/partenaires/club-lions.png" alt="Club Lions" loading="lazy" decoding="async" width="800" height="600" />
          </div>
          <div class="partner-item">
            <img src="/images/partenaires/aquadetect.png" alt="AquaDétect — Prévention de dégâts d'eau" loading="lazy" decoding="async" width="800" height="600" />
          </div>
          <div class="partner-item">
            <img src="/images/partenaires/communications-mcd.png" alt="Communications MCD" loading="lazy" decoding="async" width="800" height="600" />
          </div>
        </div>

        <div class="partners-cta" data-animate data-delay="2">
          <p>Vous souhaitez soutenir notre cause&#8239;?</p>
          <a href="/don" class="link-underline">
            Devenir partenaire
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ========== QUOTE ========== -->
    <section class="quote">
      <div class="container">
        <div class="pull-quote" data-animate>
          <blockquote>
            « Le Mouvement solidaire eSPoir, c'est l'énergie
            collective canalisée vers un seul objectif :
            la guérison. »
          </blockquote>
          <footer>Témoignage à venir</footer>
        </div>
      </div>
    </section>

    <!-- ========== NEWSLETTER ========== -->
    <section class="newsletter" id="newsletter">
      <div class="container">
        <div class="newsletter-wrapper" data-animate>
          <div class="newsletter-content">
            <span class="text-label">Pour ne rien manquer</span>
            <h2>Joignez-vous<br/>au Mouvement</h2>
            <p class="text-muted">
              Recevez les nouvelles de nos activités et de la recherche.
              Un courriel à l'occasion, jamais de pourriel.
            </p>
          </div>
          <form class="newsletter-form" action="#" method="POST">
            <div class="field">
              <input
                type="email"
                name="email"
                placeholder="votre@courriel.com"
                required
                aria-label="Adresse courriel"
                autocomplete="email"
              />
            </div>
            <button type="submit" class="btn btn-primary">
              S'abonner à l'infolettre
              <span class="btn-arrow">→</span>
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ========== IMPACT ========== */
  .impact {
    padding: clamp(7rem, 16vw, 13rem) 0;
    background: var(--color-white);
    overflow: hidden;
  }

  .impact::before {
    content: '';
    position: absolute;
    left: -15%;
    top: 50%;
    transform: translateY(-50%);
    width: 60vw;
    height: 60vw;
    max-width: 800px;
    max-height: 800px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(191, 220, 240, 0.35), rgba(191, 220, 240, 0) 65%);
    pointer-events: none;
  }

  .impact-grid {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(3rem, 9vw, 9rem);
    align-items: center;
  }

  .impact-number { position: relative; }

  .impact-content {
    max-width: 480px;
    padding-left: clamp(0rem, 4vw, 3rem);
    border-left: 1px solid var(--color-line);
  }

  .impact-content .text-muted {
    font-size: 1rem;
    line-height: 1.75;
    margin: 0;
  }

  /* ========== MISSION ========== */
  .mission {
    padding: var(--section-y) 0;
    background: var(--color-cream);
  }

  .mission-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(4rem, 9vw, 9rem);
    align-items: center;
  }

  .mission-image { aspect-ratio: 4/3; }

  .mission-content .text-label {
    margin-bottom: 1.75rem;
  }

  .mission-content h2 { margin-bottom: 2.5rem; }

  .mission-content p {
    color: var(--color-gris);
    margin-bottom: 1.5rem;
  }

  .mission-content .link-underline { margin-top: 1rem; }

  /* ========== APPROACH ========== */
  .approach {
    padding: var(--section-y) 0;
    background: var(--color-white);
  }

  .approach .section-head {
    margin-bottom: clamp(4rem, 9vw, 7rem);
  }

  /* ========== EVENT ========== */
  .event {
    padding: var(--section-y) 0;
    background: var(--color-ivory);
  }

  .event-wrapper {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(4rem, 8vw, 8rem);
    align-items: center;
  }

  .event-content .text-label { margin-bottom: 1.75rem; }
  .event-content h2 { margin-bottom: 1.75rem; }

  .event-content p {
    color: var(--color-gris);
    margin-bottom: 2.5rem;
    max-width: 340px;
  }

  .event-image { aspect-ratio: 4/3; }

  /* ========== PARTNERS ========== */
  .partners {
    padding: var(--section-y) 0;
    background: var(--color-white);
  }

  .partners .section-head {
    margin-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
    margin-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }

  .partner-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    aspect-ratio: 4/3;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    transition: background 0.5s var(--ease-elegant);
  }

  .partner-item:hover { background: var(--color-ivory); }

  .partner-item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.7;
    transition: filter 0.6s var(--ease-elegant), opacity 0.6s var(--ease-elegant), transform 0.6s var(--ease-elegant);
  }

  .partner-item:hover img {
    filter: none;
    opacity: 1;
    transform: scale(1.04);
  }

  .partners-cta {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .partners-cta p {
    margin: 0;
    color: var(--color-gris);
    font-size: 1rem;
  }

  /* ========== QUOTE ========== */
  .quote {
    padding: clamp(9rem, 17vw, 15rem) 0;
    background: var(--color-sand);
    overflow: hidden;
  }

  .quote::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 15% 20%, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0) 40%),
      radial-gradient(circle at 85% 90%, rgba(79, 163, 214, 0.18), rgba(79, 163, 214, 0) 45%);
    pointer-events: none;
  }

  /* ========== NEWSLETTER ========== */
  .newsletter {
    padding: var(--section-y) 0;
    background: var(--color-cream);
  }

  .newsletter-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(4rem, 8vw, 8rem);
    align-items: center;
  }

  .newsletter-content .text-label { margin-bottom: 1.75rem; }
  .newsletter-content h2 { margin-bottom: 1.5rem; }
  .newsletter-content p { margin: 0; max-width: 380px; }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .newsletter-form .btn { align-self: flex-start; }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 1000px) {
    .impact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .impact-content {
      border-left: none;
      padding-left: 0;
    }
  }

  @media (max-width: 900px) {
    .mission-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
    .mission-image { aspect-ratio: 16/10; }

    .event-wrapper {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
    .event-visual { order: -1; }

    .newsletter-wrapper {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 600px) {
    .partners-grid { grid-template-columns: repeat(2, 1fr); }
    .partners-cta {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .newsletter-form .btn { align-self: stretch; }
  }
</style>
