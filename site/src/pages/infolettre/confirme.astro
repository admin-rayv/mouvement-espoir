---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Bienvenue — Mouvement solidaire eSPoir"
  description="Votre abonnement à l'infolettre du Mouvement solidaire eSPoir est confirmé."
  noindex>
  <Header />

  <main id="contenu">
    <PageHero
      label="Infolettre"
      lines={['Bienvenue dans', '<em>le Mouvement.</em>']}
      description="Votre abonnement est confirmé&#8239;! Vous recevrez désormais les nouvelles de nos activités-bénéfice et de la recherche. Un courriel à l'occasion, jamais de pourriel."
    />

    <section class="suite">
      <div class="container">
        <div class="suite-content" data-animate>
          <p class="text-muted">
            En attendant la prochaine infolettre, voici deux belles façons
            de faire avancer la cause dès maintenant.
          </p>
          <div class="cta-buttons">
            <a href="/activites" class="btn btn-primary">
              Voir nos activités
              <span class="btn-arrow">→</span>
            </a>
            <a href="/don" class="link-underline">
              Faire un don
              <span class="arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .suite {
    padding: var(--section-y) 0;
    background: var(--color-white);
  }

  .suite-content { max-width: 560px; }
  .suite-content p { margin-bottom: 2.5rem; }
</style>
