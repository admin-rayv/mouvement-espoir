---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Notre histoire — Mouvement solidaire eSPoir"
  description="De trois marches-bénéfice à la fondation d'un OBNL : l'histoire de Marie-Carole Daigle et Hélène Collette, fondatrices du Mouvement solidaire eSPoir."
  preloadImage="/images/hero-histoire.jpg">
  <Header />

  <main id="contenu">
    <PageHero
      image="/images/hero-histoire.jpg"
      label="Notre histoire"
      lines={['Pourquoi le', 'Mouvement solidaire', '<em>eSPoir?</em>']}
      description="Une histoire de solidarité et d'espoir face à la sclérose en plaques"
    />

    <!-- ========== ORIGINE ========== -->
    <section class="origine">
      <div class="container">
        <div class="origine-grid">
          <header class="section-head" data-animate>
            <span class="text-label">L'origine</span>
            <h2>Tout a commencé<br/>par une volonté d'agir</h2>
          </header>

          <div class="origine-text" data-animate data-delay="2">
            <p class="text-lead">
              En 2023, Marie-Carole Daigle apprend une nouvelle qui la
              bouleverse : quelqu'un qui lui est cher vient de recevoir
              un diagnostic de sclérose en plaques.
            </p>
            <p>
              Mais une chose la surprend profondément : la réaction de
              cette personne, résolue à ne pas laisser la maladie dicter
              la suite. Une véritable leçon de vie.
            </p>
            <p>
              Dans cet esprit, Marie-Carole décide elle aussi de faire
              front — et choisit l'action.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== PARCOURS ========== -->
    <section class="parcours">
      <div class="container">
        <div class="parcours-top">
          <header class="section-head" data-animate>
            <span class="text-label">Le parcours</span>
            <h2>De la marche<br/>au mouvement</h2>
          </header>

          <figure class="parcours-photo frame-offset" data-animate="reveal" data-delay="2">
            <div class="image-frame">
              <img src="/images/marche-benefice-sclerose-en-plaques-equipe-espoir.jpg" alt="L'équipe eSPoir souriante lors d'une marche-bénéfice pour la sclérose en plaques" width="1069" height="1080" loading="lazy" decoding="async" />
            </div>
            <figcaption class="caption">L'équipe eSPoir, marche-bénéfice de mai 2025.</figcaption>
          </figure>
        </div>

        <div class="timeline">
          <article class="timeline-item" data-animate data-delay="1">
            <span class="timeline-year">2023</span>
            <div>
              <h3>Première démarche</h3>
              <p>
                Marie-Carole et son équipe participent à une marche-bénéfice
                organisée par une grande fondation à Montréal.
                Résultat : <strong>780&nbsp;$</strong> en dons.
              </p>
            </div>
          </article>

          <article class="timeline-item" data-animate data-delay="2">
            <span class="timeline-year">2024</span>
            <div>
              <h3>211&#8239;% de l'objectif : la preuve qu'on peut aller encore plus loin</h3>
              <p>
                Plus de participants, plus de solidarité. L'équipe participe
                à une deuxième marche-bénéfice et amasse
                <strong>2 535&nbsp;$</strong>. Une idée émerge : et si l'on
                faisait plus qu'une activité par année&#8239;?
              </p>
            </div>
          </article>

          <article class="timeline-item" data-animate data-delay="3">
            <span class="timeline-year">2025</span>
            <div>
              <h3>L'équipe s'agrandit</h3>
              <p>
                L'élan est là : <strong>2 805&nbsp;$</strong> en dons.
                Une question surgit : si cet argent était entièrement géré
                par des bénévoles et versé directement à la recherche sur
                la guérison&#8239;?
              </p>
            </div>
          </article>

          <article class="timeline-item is-highlight" data-animate data-delay="4">
            <span class="timeline-year">Oct. 2025</span>
            <div>
              <h3>Naissance du Mouvement</h3>
              <p>
                Marie-Carole Daigle et Hélène Collette fondent le
                <strong>Mouvement solidaire eSPoir</strong>.
                Objectif : consacrer 100&#8239;% des revenus nets de nos
                activités-bénéfice à la recherche sur la guérison de la
                sclérose en plaques.
              </p>
            </div>
          </article>

          <article class="timeline-item" data-animate data-delay="5">
            <span class="timeline-year">Nov. 2025</span>
            <div>
              <h3>Premier souper-spectacle</h3>
              <p>
                Le Mouvement organise un premier souper-spectacle offert à
                un prix très abordable, grâce à des dons en biens et services
                et à l'engagement du milieu&#8239;! L'activité permet de
                réaliser un bénéfice de <strong>3 424&nbsp;$</strong>.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== VISION ========== -->
    <section class="vision">
      <div class="container">
        <div class="pull-quote" data-animate>
          <blockquote>
            « Et si chaque dollar amassé allait
            directement à la recherche? »
          </blockquote>
          <p class="vision-text">
            C'est la question qui a tout changé.
            Le Mouvement solidaire eSPoir est né de cette conviction :
            maximiser l'impact des contributions.
          </p>
        </div>
      </div>
    </section>

    <!-- ========== ÉQUIPE ========== -->
    <section class="equipe">
      <div class="container">
        <header class="section-head" data-animate>
          <span class="text-label">L'équipe</span>
          <h2>Les fondatrices</h2>
        </header>

        <div class="equipe-grid">
          <article class="membre">
            <div class="membre-photo frame-offset" data-animate="reveal">
              <div class="image-frame">
                <img src="/images/marie-carole.jpg" alt="Marie-Carole Daigle, fondatrice et présidente du Mouvement solidaire eSPoir" width="923" height="1200" loading="lazy" decoding="async" />
              </div>
            </div>
            <div class="membre-info" data-animate data-delay="2">
              <h3>Marie-Carole Daigle</h3>
              <span class="membre-role">Fondatrice et présidente</span>
              <p>
                Forte de 40 ans d'expérience en communications,
                Marie-Carole a toujours eu à cœur de donner de son
                temps dans les milieux qu'elle côtoie.
              </p>
              <p>
                Sensibilisée à la réalité de la SP, elle a choisi
                de s'engager pleinement dans cette mission : financer
                la recherche pour offrir un espoir de guérison aux
                personnes touchées.
              </p>
            </div>
          </article>

          <article class="membre">
            <div class="membre-photo frame-offset" data-animate="reveal">
              <div class="image-frame">
                <img src="/images/helene.jpg" alt="Hélène Collette, cofondatrice du Mouvement solidaire eSPoir" width="390" height="500" loading="lazy" decoding="async" />
              </div>
            </div>
            <div class="membre-info" data-animate data-delay="2">
              <h3>Hélène Collette</h3>
              <span class="membre-role">Cofondatrice</span>
              <p>
                Hélène vit avec la sclérose en plaques depuis 2006,
                une réalité qui a profondément façonné son parcours
                tant personnel que professionnel.
              </p>
              <p>
                Elle met au service du Mouvement une expertise stratégique
                rigoureuse, portée par une vision engagée. Son expérience
                de la SP alimente chaque jour sa détermination à faire
                avancer la recherche et à contribuer concrètement à un
                avenir porteur d'espoir.
              </p>
            </div>
          </article>
        </div>

        <figure class="equipe-photo" data-animate="reveal">
          <div class="image-frame">
            <img src="/images/fondatrices-mouvement-espoir-seance-travail.jpg" alt="Marie-Carole Daigle et Hélène Collette en séance de travail" width="1920" height="2117" loading="lazy" decoding="async" />
          </div>
          <figcaption class="caption">Marie-Carole et Hélène en séance de travail.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ========== TRANSPARENCE ========== -->
    <section class="transparence">
      <div class="container">
        <div class="transparence-grid">
          <div class="transparence-visual" data-animate>
            <span class="text-huge"><span data-count="100">100</span>&#8239;%</span>
            <span class="transparence-label">va à la recherche</span>
          </div>

          <div class="transparence-content" data-animate data-delay="2">
            <span class="text-label">Transparence</span>
            <h2>Où vont les<br/>dons reçus&#8239;?</h2>
            <p>
              Tout notre travail est bénévole. Chaque dollar de bénéfice
              finance directement des projets de recherche sur la
              sclérose en plaques.
            </p>
            <p>
              Aucuns frais administratifs. Aucun salaire.
              Que de l'espoir transformé en action.
            </p>
            <div class="transparence-legal">
              <span>OBNL enregistré au Québec</span>
              <span>NEQ : 1181 4407 11</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== CTA ========== -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-content" data-animate>
          <h2>Joignez<br/>le mouvement</h2>
          <p>
            Ensemble, finançons l'espoir de guérison.
          </p>
          <div class="cta-buttons">
            <a href="/activites" class="btn btn-primary">
              Voir les activités
              <span class="btn-arrow">→</span>
            </a>
            <a href="/don" class="link-underline">
              Faire un don
              <span class="arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ========== ORIGINE ========== */
  .origine {
    padding: var(--section-y) 0;
    background: var(--color-white);
  }

  .origine-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .origine-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 560px;
    padding-top: 0.5rem;
  }

  .origine-text .text-lead { margin: 0 0 0.5rem; }

  .origine-text p {
    color: var(--color-gris);
    margin: 0;
    line-height: 1.8;
  }

  .origine-text .text-lead { color: var(--color-noir); }

  /* ========== PARCOURS ========== */
  .parcours {
    padding: var(--section-y) 0;
    background: var(--color-cream);
  }

  .parcours-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 400px);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    margin-bottom: clamp(4rem, 9vw, 7rem);
  }

  .parcours-photo { margin: 0; }
  .parcours-photo .image-frame { aspect-ratio: 1 / 1; }
  .parcours-photo figcaption { margin-top: 1.5rem; }

  /* ========== VISION ========== */
  .vision {
    padding: clamp(9rem, 17vw, 15rem) 0;
    background: var(--color-sand);
    overflow: hidden;
  }

  .vision::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 15% 20%, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0) 40%),
      radial-gradient(circle at 85% 90%, rgba(79, 163, 214, 0.18), rgba(79, 163, 214, 0) 45%);
    pointer-events: none;
  }

  .vision-text {
    color: var(--color-gris);
    font-size: 1.0625rem;
    line-height: 1.8;
    max-width: 540px;
    margin: 2.5rem auto 0;
  }

  /* ========== ÉQUIPE ========== */
  .equipe {
    padding: var(--section-y) 0;
    background: var(--color-white);
  }

  .equipe .section-head {
    margin-bottom: clamp(4rem, 9vw, 6rem);
  }

  .equipe-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(5rem, 10vw, 8rem);
  }

  .membre {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .membre:nth-child(even) .membre-photo { order: 2; }

  .membre-photo .image-frame { aspect-ratio: 4/5; }

  .membre-info { max-width: 540px; }

  .membre-info h3 {
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    margin-bottom: 0.75rem;
    font-weight: 300;
  }

  .membre-role {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-marine);
    margin-bottom: 2rem;
  }

  .membre-role::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: var(--color-accent);
  }

  .membre-info p {
    color: var(--color-gris);
    margin: 0 0 1.25rem 0;
    line-height: 1.8;
  }

  .equipe-photo {
    margin: clamp(5rem, 10vw, 8rem) auto 0;
    max-width: 860px;
  }

  .equipe-photo .image-frame { aspect-ratio: 4 / 3; }
  .equipe-photo .image-frame img { object-position: center 25%; }
  .equipe-photo figcaption { margin-top: 1.5rem; }

  /* ========== TRANSPARENCE ========== */
  .transparence {
    padding: var(--section-y) 0;
    background: var(--color-ivory);
    overflow: hidden;
  }

  .transparence::before {
    content: '';
    position: absolute;
    left: -15%;
    top: 50%;
    transform: translateY(-50%);
    width: 60vw;
    height: 60vw;
    max-width: 800px;
    max-height: 800px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(191, 220, 240, 0.4), rgba(191, 220, 240, 0) 65%);
    pointer-events: none;
  }

  .transparence-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(4rem, 9vw, 9rem);
    align-items: center;
  }

  .transparence-visual {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .transparence-label {
    font-size: 0.8125rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gris);
    margin-top: 1.5rem;
  }

  .transparence-content .text-label { margin-bottom: 1.75rem; }
  .transparence-content h2 { margin-bottom: 2rem; }

  .transparence-content p {
    color: var(--color-gris);
    margin: 0 0 1.5rem 0;
    line-height: 1.8;
  }

  .transparence-legal {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }

  .transparence-legal span {
    font-size: 0.8125rem;
    color: var(--color-gris);
    letter-spacing: 0.04em;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 900px) {
    .origine-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .parcours-top {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 3rem;
    }

    .parcours-photo { max-width: 440px; }

    .membre {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .membre:nth-child(even) .membre-photo { order: 0; }

    .membre-photo { max-width: 420px; }

    .transparence-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }
</style>
