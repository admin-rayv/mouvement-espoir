---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Notre histoire — Mouvement solidaire eSPoir">
  <Header />

  <main>
    <!-- ========== HERO ========== -->
    <section class="hero">
      <div class="hero-visual">
        <div class="hero-image">
          <img src="/images/hero-histoire.jpg" alt="" />
        </div>
        <div class="hero-overlay"></div>
      </div>

      <div class="hero-content">
        <div class="hero-tagline" data-animate data-delay="1">
          <span class="text-label">Notre histoire</span>
        </div>

        <h1 data-animate data-delay="2">
          <span class="hero-line">Pourquoi le</span>
          <span class="hero-line">Mouvement solidaire</span>
          <span class="hero-line hero-accent">eSPoir?</span>
        </h1>

        <div class="hero-bottom" data-animate data-delay="3">
          <p class="hero-description">
            Une histoire de solidarité et d'espoir
            face à la sclérose en plaques
          </p>
        </div>
      </div>
    </section>

    <!-- ========== ORIGINE ========== -->
    <section class="origine">
      <div class="container">
        <div class="origine-content" data-animate>
          <span class="text-label">L'origine</span>
          <h2>Tout a commencé<br/>par une volonté d'agir</h2>

          <div class="origine-text">
            <p class="text-lead">
              En 2023, Marie-Carole Daigle apprend une nouvelle qui la
              bouleverse : quelqu'un qui lui est cher vient de recevoir
              un diagnostic de sclérose en plaques.
            </p>
            <p>
              Mais une chose la surprend profondément : la réaction de
              cette personne, résolue à ne pas laisser la maladie dicter
              la suite. Une véritable leçon de vie.
            </p>
            <p>
              Dans cet esprit, Marie-Carole décide elle aussi de faire
              front — et choisit l'action.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== PARCOURS ========== -->
    <section class="parcours">
      <div class="container">
        <div class="parcours-top">
          <header class="parcours-header" data-animate>
            <span class="text-label">Le parcours</span>
            <h2>De la marche<br/>au mouvement</h2>
          </header>

          <figure class="parcours-photo" data-animate data-delay="2">
            <div class="image-frame">
              <img src="/images/marche-benefice-sclerose-en-plaques-equipe-espoir.jpg" alt="L'équipe eSPoir souriante lors d'une marche-bénéfice pour la sclérose en plaques" loading="lazy" />
            </div>
            <figcaption>L'équipe eSPoir, marche-bénéfice de mai 2025.</figcaption>
          </figure>
        </div>

        <div class="parcours-timeline">
          <article class="parcours-item" data-animate data-delay="1">
            <span class="parcours-year">2023</span>
            <div class="parcours-content">
              <h3>Première démarche</h3>
              <p>
                Marie-Carole et son équipe participent à une marche-bénéfice
                organisée par une grande fondation à Montréal.
                Résultat : <strong>780&nbsp;$</strong> en dons.
              </p>
            </div>
          </article>

          <article class="parcours-item" data-animate data-delay="2">
            <span class="parcours-year">2024</span>
            <div class="parcours-content">
              <h3>211&#8239;% de l'objectif : la preuve qu'on peut aller encore plus loin</h3>
              <p>
                Plus de participants, plus de solidarité. L'équipe participe
                à une deuxième marche-bénéfice et amasse
                <strong>2 535&nbsp;$</strong>. Une idée émerge : et si l'on
                faisait plus qu'une activité par année&#8239;?
              </p>
            </div>
          </article>

          <article class="parcours-item" data-animate data-delay="3">
            <span class="parcours-year">2025</span>
            <div class="parcours-content">
              <h3>L'équipe s'agrandit</h3>
              <p>
                L'élan est là : <strong>2 805&nbsp;$</strong> en dons.
                Une question surgit : si cet argent était entièrement géré
                par des bénévoles et versé directement à la recherche sur
                la guérison&#8239;?
              </p>
            </div>
          </article>

          <article class="parcours-item parcours-item-highlight" data-animate data-delay="4">
            <span class="parcours-year">Oct. 2025</span>
            <div class="parcours-content">
              <h3>Naissance du Mouvement</h3>
              <p>
                Marie-Carole Daigle et Hélène Collette fondent le
                <strong>Mouvement solidaire eSPoir</strong>.
                Objectif : consacrer 100&#8239;% des revenus nets de nos
                activités-bénéfice à la recherche sur la guérison de la
                sclérose en plaques.
              </p>
            </div>
          </article>

          <article class="parcours-item" data-animate data-delay="5">
            <span class="parcours-year">Nov. 2025</span>
            <div class="parcours-content">
              <h3>Premier souper-spectacle</h3>
              <p>
                Le Mouvement organise un premier souper-spectacle offert à
                un prix très abordable, grâce à des dons en biens et services
                et à l'engagement du milieu&#8239;! L'activité permet de
                réaliser un bénéfice de <strong>3 424&nbsp;$</strong>.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== VISION ========== -->
    <section class="vision">
      <div class="container">
        <div class="vision-content" data-animate>
          <blockquote>
            « Et si chaque dollar amassé allait
            directement à la recherche? »
          </blockquote>
          <p class="vision-text">
            C'est la question qui a tout changé.
            Le Mouvement solidaire eSPoir est né de cette conviction :
            maximiser l'impact des contributions.
          </p>
        </div>
      </div>
    </section>

    <!-- ========== ÉQUIPE ========== -->
    <section class="equipe">
      <div class="container">
        <header class="equipe-header" data-animate>
          <span class="text-label">L'équipe</span>
          <h2>Les fondatrices</h2>
        </header>

        <div class="equipe-grid">
          <article class="membre" data-animate data-delay="1">
            <div class="membre-photo image-frame">
              <img src="/images/marie-carole.jpg" alt="Marie-Carole Daigle, fondatrice et présidente du Mouvement solidaire eSPoir" />
            </div>
            <div class="membre-info">
              <h3>Marie-Carole Daigle</h3>
              <span class="membre-role">Fondatrice et présidente</span>
              <p>
                Forte de 40 ans d'expérience en communications,
                Marie-Carole a toujours eu à cœur de donner de son
                temps dans les milieux qu'elle côtoie.
              </p>
              <p>
                Sensibilisée à la réalité de la SP, elle a choisi
                de s'engager pleinement dans cette mission : financer
                la recherche pour offrir un espoir de guérison aux
                personnes touchées.
              </p>
            </div>
          </article>

          <article class="membre" data-animate data-delay="2">
            <div class="membre-photo image-frame">
              <img src="/images/helene.jpg" alt="Hélène Collette, cofondatrice du Mouvement solidaire eSPoir" />
            </div>
            <div class="membre-info">
              <h3>Hélène Collette</h3>
              <span class="membre-role">Cofondatrice</span>
              <p>
                Hélène vit avec la sclérose en plaques depuis 2006,
                une réalité qui a profondément façonné son parcours
                tant personnel que professionnel.
              </p>
              <p>
                Elle met au service du Mouvement une expertise stratégique
                rigoureuse, portée par une vision engagée. Son expérience
                de la SP alimente chaque jour sa détermination à faire
                avancer la recherche et à contribuer concrètement à un
                avenir porteur d'espoir.
              </p>
            </div>
          </article>
        </div>

        <figure class="equipe-photo" data-animate>
          <div class="image-frame">
            <img src="/images/fondatrices-mouvement-espoir-seance-travail.jpg" alt="Marie-Carole Daigle et Hélène Collette en séance de travail" loading="lazy" />
          </div>
          <figcaption>Marie-Carole et Hélène en séance de travail.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ========== TRANSPARENCE ========== -->
    <section class="transparence">
      <div class="container">
        <div class="transparence-grid">
          <div class="transparence-visual" data-animate>
            <span class="transparence-number">100&#8239;%</span>
            <span class="transparence-label">va à la recherche</span>
          </div>

          <div class="transparence-content" data-animate data-delay="2">
            <span class="text-label">Transparence</span>
            <h2>Où vont les<br/>dons reçus&#8239;?</h2>
            <p>
              Tout notre travail est bénévole. Chaque dollar de bénéfice
              finance directement des projets de recherche sur la
              sclérose en plaques.
            </p>
            <p>
              Aucuns frais administratifs. Aucun salaire.
              Que de l'espoir transformé en action.
            </p>
            <div class="transparence-legal">
              <span>OBNL enregistré au Québec</span>
              <span>NEQ : 1181 4407 11</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== CTA ========== -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-content" data-animate>
          <h2>Joignez<br/>le mouvement</h2>
          <p>
            Ensemble, finançons l'espoir de guérison.
          </p>
          <div class="cta-buttons">
            <a href="/activites" class="link-underline">
              Voir les activités
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ========== HERO ========== */
  .hero {
    position: relative;
    min-height: 55vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0;
    overflow: hidden;
  }

  .hero-visual {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    display: block;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(27, 58, 95, 0.3) 0%,
      rgba(27, 58, 95, 0.6) 50%,
      rgba(27, 58, 95, 0.9) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: clamp(3rem, 6vw, 6rem);
    padding-top: clamp(7rem, 12vh, 10rem);
    color: white;
    max-width: 1200px;
  }

  .hero-tagline {
    margin-bottom: 2rem;
  }

  .hero-tagline .text-label {
    color: rgba(255, 255, 255, 0.85);
  }

  .hero h1 {
    color: white;
    margin-bottom: 3rem;
    font-weight: 300;
  }

  .hero-line {
    display: block;
  }

  .hero-accent {
    color: var(--color-accent);
    font-style: italic;
  }

  .hero-description {
    max-width: 380px;
    font-size: 1rem;
    line-height: 1.8;
    opacity: 0.9;
    margin: 0;
    font-weight: 300;
  }

  /* ========== ORIGINE ========== */
  .origine {
    padding: clamp(8rem, 15vw, 12rem) 0;
    background: var(--color-white);
  }

  .origine-content {
    max-width: 680px;
  }

  .origine-content .text-label {
    margin-bottom: 2rem;
    display: block;
  }

  .origine-content h2 {
    margin-bottom: 3rem;
  }

  .origine-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .origine-text .text-lead {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--color-noir);
  }

  .origine-text p {
    color: var(--color-gris);
    margin: 0;
    line-height: 1.8;
  }

  .origine-text strong {
    color: var(--color-noir);
    font-weight: 500;
  }

  /* ========== PARCOURS ========== */
  .parcours {
    padding: clamp(8rem, 15vw, 12rem) 0;
    background: var(--color-cream);
  }

  .parcours-header {
    margin-bottom: clamp(5rem, 10vw, 8rem);
    max-width: 500px;
  }

  .parcours-header .text-label {
    margin-bottom: 2rem;
    display: block;
  }

  .parcours-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 400px);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    margin-bottom: clamp(5rem, 10vw, 8rem);
  }

  .parcours-top .parcours-header {
    margin-bottom: 0;
  }

  .parcours-photo {
    margin: 0;
  }

  .parcours-photo .image-frame {
    aspect-ratio: 1 / 1;
  }

  .parcours-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .parcours-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 3rem;
    padding: 3rem 0;
    border-bottom: 1px solid var(--color-sand);
  }

  .parcours-item:first-child {
    border-top: 1px solid var(--color-sand);
  }

  .parcours-year {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--color-gris-clair);
    letter-spacing: 0.02em;
  }

  .parcours-content h3 {
    font-size: 1.375rem;
    margin-bottom: 1rem;
    font-weight: 300;
  }

  .parcours-content p {
    color: var(--color-gris);
    margin: 0;
    max-width: 500px;
    line-height: 1.7;
  }

  .parcours-content strong {
    color: var(--color-noir);
    font-weight: 500;
  }

  .parcours-content em {
    font-style: italic;
  }

  .parcours-item-highlight {
    background: var(--color-ivory);
    margin: 0 -2rem;
    padding: 3rem 2rem;
    border: none;
  }

  .parcours-item-highlight .parcours-year {
    color: var(--color-noir);
    font-weight: 500;
  }

  .parcours-photo figcaption,
  .equipe-photo figcaption {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-gris-clair);
    letter-spacing: 0.04em;
  }

  /* ========== VISION ========== */
  .vision {
    padding: clamp(10rem, 18vw, 16rem) 0;
    background: var(--color-sand);
  }

  .vision-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .vision-content blockquote {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-noir);
    border: none;
    padding: 0;
    margin: 0 0 2.5rem 0;
    font-style: normal;
  }

  .vision-content blockquote em {
    font-style: italic;
  }

  .vision-text {
    color: var(--color-gris);
    font-size: 1.0625rem;
    line-height: 1.8;
    max-width: 540px;
    margin: 0 auto;
  }

  /* ========== ÉQUIPE ========== */
  .equipe {
    padding: clamp(8rem, 15vw, 12rem) 0;
    background: var(--color-white);
  }

  .equipe-header {
    margin-bottom: clamp(5rem, 10vw, 6rem);
    max-width: 400px;
  }

  .equipe-header .text-label {
    margin-bottom: 2rem;
    display: block;
  }

  .equipe-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(5rem, 10vw, 8rem);
  }

  .membre {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  .membre:nth-child(even) {
    direction: rtl;
  }

  .membre:nth-child(even) > * {
    direction: ltr;
  }

  .membre-photo {
    aspect-ratio: 4/5;
  }

  .membre-info h3 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
    font-weight: 300;
  }

  .membre-role {
    display: block;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gris-clair);
    margin-bottom: 2rem;
  }

  .membre-info p {
    color: var(--color-gris);
    margin: 0 0 1.25rem 0;
    line-height: 1.8;
  }

  .equipe-photo {
    margin: clamp(5rem, 10vw, 8rem) 0 0;
    max-width: 860px;
  }

  .equipe-photo .image-frame {
    aspect-ratio: 4 / 3;
  }

  .equipe-photo .image-frame img {
    object-position: center 25%;
  }

  /* ========== TRANSPARENCE ========== */
  .transparence {
    padding: clamp(8rem, 15vw, 12rem) 0;
    background: var(--color-ivory);
  }

  .transparence-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(5rem, 10vw, 10rem);
    align-items: center;
  }

  .transparence-visual {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .transparence-number {
    font-family: var(--font-heading);
    font-size: clamp(5rem, 15vw, 10rem);
    font-weight: 300;
    color: var(--color-noir);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .transparence-label {
    font-size: 1.125rem;
    color: var(--color-gris);
    margin-top: 1rem;
    letter-spacing: 0.02em;
  }

  .transparence-content .text-label {
    margin-bottom: 2rem;
    display: block;
  }

  .transparence-content h2 {
    margin-bottom: 2rem;
  }

  .transparence-content p {
    color: var(--color-gris);
    margin: 0 0 1.5rem 0;
    line-height: 1.8;
  }

  .transparence-legal {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-sand);
  }

  .transparence-legal span {
    font-size: 0.875rem;
    color: var(--color-gris-clair);
    letter-spacing: 0.02em;
  }

  /* ========== CTA ========== */
  .cta-section {
    padding: clamp(8rem, 15vw, 12rem) 0;
    background: var(--color-cream);
  }

  .cta-content {
    max-width: 500px;
  }

  .cta-content h2 {
    margin-bottom: 1.5rem;
  }

  .cta-content > p {
    color: var(--color-gris);
    margin-bottom: 3rem;
    font-size: 1.0625rem;
  }

  .cta-buttons {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 900px) {
    .parcours-top {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 3rem;
    }

    .parcours-photo {
      max-width: 480px;
    }

    .parcours-item {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .parcours-item-highlight {
      margin: 0 -1rem;
      padding: 2.5rem 1rem;
    }

    .membre {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .membre:nth-child(even) {
      direction: ltr;
    }

    .membre-photo {
      aspect-ratio: 16/10;
    }

    .transparence-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .transparence-visual {
      align-items: center;
      text-align: center;
    }
  }

  @media (max-width: 600px) {
    .cta-buttons {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }
</style>

<script>
  // Scroll animations
  const animatedElements = document.querySelectorAll('[data-animate]');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, {
    threshold: 0.15,
    rootMargin: '0px 0px -80px 0px'
  });

  animatedElements.forEach(el => observer.observe(el));
</script>
