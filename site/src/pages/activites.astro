---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Nos activités — Mouvement solidaire eSPoir"
  description="Soupers-spectacles, soirées thématiques et marches-bénéfice : nos activités rassemblent la communauté et financent la recherche sur la sclérose en plaques."
  preloadImage="/images/souper-spectacle-hommage-crooners-2025.jpg">
  <Header />

  <main id="contenu">
    <PageHero
      image="/images/souper-spectacle-hommage-crooners-2025.jpg"
      label="Nos activités"
      lines={['Des rassemblements', 'qui financent', '<em>l\'espoir.</em>']}
      description="Chaque activité rassemble la communauté — et 100&#8239;% des bénéfices vont à la recherche sur la guérison de la sclérose en plaques."
    />

    <!-- ========== À VENIR ========== -->
    <section class="a-venir">
      <div class="container">
        <div class="a-venir-grid">
          <header class="section-head" data-animate>
            <span class="text-label">À venir</span>
            <h2>On vous prépare<br/>quelque chose pour bientôt&#8239;!</h2>
          </header>
          <div class="a-venir-content" data-animate data-delay="2">
            <p>
              Le Mouvement travaille en ce moment sur sa prochaine
              activité-bénéfice. Inscrivez-vous à l'infolettre pour être
              informé en premier — et ne rien manquer.
            </p>
            <a href="/#newsletter" class="btn btn-secondary">
              Être informé
              <span class="btn-arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== ACTIVITÉS PASSÉES ========== -->
    <section class="passees">
      <div class="container">
        <header class="section-head passees-head" data-animate>
          <span class="text-label">Nos réalisations</span>
          <h2>Ce que nous avons<br/>accompli ensemble</h2>
        </header>

        <div class="timeline">
          <article class="timeline-item" data-animate data-delay="1">
            <span class="timeline-year">Nov. 2025</span>
            <div>
              <h3>Souper-spectacle «&nbsp;Hommage aux crooners&nbsp;»</h3>
              <p>
                Première activité officielle du Mouvement : un
                souper-spectacle à <strong>75&nbsp;$</strong> mettant
                en vedette le chanteur Gil Albert, tenu le
                15 novembre 2025 à l'Oasis Marina de Repentigny.
                Offerte à prix abordable grâce à des dons en biens et
                services et à l'engagement du milieu, l'activité a
                dégagé un bénéfice de <strong>3 424&nbsp;$</strong>,
                versé entièrement à la recherche sur la sclérose en
                plaques.
              </p>
              <div class="passees-photos">
                <div data-animate="reveal">
                  <div class="image-frame">
                    <img src="/images/marie-carole-daigle-allocution-souper-spectacle.jpg" alt="Marie-Carole Daigle s'adresse aux convives du souper-spectacle" width="1920" height="2560" loading="lazy" decoding="async" />
                  </div>
                </div>
                <div data-animate="reveal" data-delay="2">
                  <div class="image-frame">
                    <img src="/images/affiche-souper-spectacle-crooners-2025.jpg" alt="Affiche du souper-spectacle Hommage aux crooners 2025" width="1036" height="1600" loading="lazy" decoding="async" />
                  </div>
                </div>
              </div>
            </div>
          </article>

          <article class="timeline-item" data-animate data-delay="2">
            <span class="timeline-year">Mai 2025</span>
            <div>
              <h3>Marche-bénéfice</h3>
              <p>
                Avant même la fondation du Mouvement, l'équipe amasse
                <strong>2 805&nbsp;$</strong> lors d'une marche-bénéfice
                organisée avec une grande fondation à Montréal.
              </p>
            </div>
          </article>

          <article class="timeline-item" data-animate data-delay="3">
            <span class="timeline-year">Mai 2024</span>
            <div>
              <h3>Marche-bénéfice</h3>
              <p>
                Deuxième participation à la marche-bénéfice d'une grande
                fondation à Montréal : <strong>2 535&nbsp;$</strong> amassés,
                soit 211&#8239;% de l'objectif&#8239;!
              </p>
            </div>
          </article>

          <article class="timeline-item" data-animate data-delay="4">
            <span class="timeline-year">Mai 2023</span>
            <div>
              <h3>Première marche-bénéfice</h3>
              <p>
                Le point de départ de l'aventure : une première marche
                avec une grande fondation à Montréal, et
                <strong>780&nbsp;$</strong> amassés pour la cause.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== NOS FORMULES ========== -->
    <section class="formules">
      <div class="container">
        <header class="section-head formules-head" data-animate>
          <span class="text-label">Nos formules</span>
          <h2>Des activités<br/>pour tous les goûts</h2>
        </header>

        <div class="num-list">
          <article class="num-item" data-animate data-delay="1">
            <span class="num-index">01</span>
            <h3>Spectacles et soupers-bénéfice</h3>
            <p>
              Des artistes et de la gastronomie réunis au profit de la
              recherche, dans une ambiance chaleureuse.
            </p>
          </article>

          <article class="num-item" data-animate data-delay="2">
            <span class="num-index">02</span>
            <h3>Soirées thématiques</h3>
            <p>
              Humour, musique, découvertes : des soirées qui font du bien
              et qui font avancer la cause.
            </p>
          </article>

          <article class="num-item" data-animate data-delay="3">
            <span class="num-index">03</span>
            <h3>Activités communautaires</h3>
            <p>
              Marches et rassemblements familiaux, pour bouger et se
              retrouver, ensemble, autour de l'espoir.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== CTA ========== -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-content" data-animate>
          <h2>Une idée<br/>d'activité&#8239;?</h2>
          <p>
            Vous aimeriez organiser une collecte ou proposer un
            partenariat pour la cause&#8239;? Parlons-en.
          </p>
          <div class="cta-buttons">
            <a href="mailto:info@msespoir.ca?subject=Proposition%20d%27activit%C3%A9" class="btn btn-primary">
              Proposer une activité
              <span class="btn-arrow">→</span>
            </a>
            <a href="/don" class="link-underline">
              Faire un don
              <span class="arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ========== À VENIR ========== */
  .a-venir {
    padding: var(--section-y) 0;
    background: var(--color-white);
  }

  .a-venir-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .a-venir-content p {
    color: var(--color-gris);
    margin: 0 0 2.5rem 0;
    line-height: 1.8;
    max-width: 480px;
  }

  /* ========== ACTIVITÉS PASSÉES ========== */
  .passees {
    padding: var(--section-y) 0;
    background: var(--color-cream);
  }

  .passees-head { margin-bottom: clamp(4rem, 9vw, 6rem); }

  .passees-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 2.5rem;
    max-width: 640px;
  }

  .passees-photos .image-frame { aspect-ratio: 13/20; }

  /* ========== NOS FORMULES ========== */
  .formules {
    padding: var(--section-y) 0;
    background: var(--color-white);
  }

  .formules-head { margin-bottom: clamp(4rem, 9vw, 7rem); }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 900px) {
    .a-venir-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .passees-photos { grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  }

  @media (max-width: 480px) {
    .passees-photos { grid-template-columns: 1fr; }
  }
</style>
