---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Faire un don — Mouvement solidaire eSPoir">
  <Header />

  <main>
    <!-- ========== HERO ========== -->
    <section class="hero">
      <div class="hero-visual">
        <div class="hero-image">
          <img src="/images/hero-home.jpg" alt="" />
        </div>
        <div class="hero-overlay"></div>
      </div>

      <div class="hero-content">
        <div class="hero-tagline" data-animate data-delay="1">
          <span class="text-label">Faire un don</span>
        </div>

        <h1 data-animate data-delay="2">
          <span class="hero-line">Chaque dollar</span>
          <span class="hero-line hero-accent">finance la guérison.</span>
        </h1>

        <div class="hero-bottom" data-animate data-delay="3">
          <p class="hero-description">
            Le Mouvement solidaire eSPoir est entièrement bénévole&#8239;:
            100&#8239;% des revenus nets de nos activités-bénéfice vont
            à la recherche sur la guérison de la sclérose en plaques.
          </p>
        </div>
      </div>
    </section>

    <!-- ========== PROMESSE ========== -->
    <section class="promesse">
      <div class="container">
        <div class="promesse-grid">
          <div class="promesse-number" data-animate>
            <span class="text-huge">100&#8239;%</span>
          </div>
          <div class="promesse-content" data-animate data-delay="2">
            <p class="text-display">
              de votre don finance<br/>
              directement la recherche
            </p>
            <div class="divider"></div>
            <p class="text-muted">
              Aucuns frais administratifs. Tout notre travail est bénévole.
              Chaque dollar dégagé par nos activités-bénéfice va à la recherche.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== MANIFESTE ========== -->
    <section class="manifeste">
      <div class="container">
        <blockquote class="manifeste-quote" data-animate>
          Vous ne pouvez peut-être pas guérir<br/>
          la sclérose en plaques.<br/>
          <span class="manifeste-accent">Mais vous pouvez aider<br/>ceux qui le peuvent.</span>
        </blockquote>
      </div>
    </section>

    <!-- ========== COMMENT DONNER ========== -->
    <section class="methodes">
      <div class="container">
        <header class="methodes-header" data-animate>
          <span class="text-label">Comment donner</span>
          <h2>Deux façons simples<br/>de contribuer.</h2>
        </header>

        <div class="methodes-items">
          <article class="methode-item" data-animate data-delay="1">
            <span class="methode-number">01</span>
            <h3>Virement Interac</h3>
            <p>
              Le moyen le plus rapide. Envoyez votre virement à
              l'adresse&nbsp;<strong>info@msespoir.ca</strong> et
              précisez «&nbsp;Don&nbsp;» dans le message accompagnant
              le transfert.
            </p>
            <a href="mailto:info@msespoir.ca?subject=Don%20%E2%80%94%20Virement%20Interac" class="link-underline">
              Nous écrire pour les détails
            </a>
          </article>

          <article class="methode-item" data-animate data-delay="2">
            <span class="methode-number">02</span>
            <h3>Par chèque</h3>
            <p>
              Libellez votre chèque à l'ordre du <strong>Mouvement
              solidaire eSPoir</strong> et postez-le au&nbsp;:<br/>
              243, boul. Brien, bureau 250<br/>
              Repentigny (Québec)&nbsp;&nbsp;J6A 6M4
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== REÇUS FISCAUX ========== -->
    <section class="recus">
      <div class="container">
        <div class="recus-content" data-animate>
          <span class="text-label">Reçus fiscaux</span>
          <h2>Une étape encore<br/>à venir.</h2>

          <p class="text-lead">
            Le Mouvement solidaire eSPoir est un organisme à but non
            lucratif enregistré au Québec (NEQ&nbsp;: 1181 4407 11) et
            est actuellement en démarches pour obtenir le statut
            d'organisme de bienfaisance enregistré auprès de l'Agence
            du revenu du Canada.
          </p>
          <p>
            Pour l'instant, nous ne pouvons pas émettre de reçus
            officiels aux fins d'impôt. Votre contribution n'en est pas
            moins précieuse — chaque dollar reçu finance directement
            la recherche. Nous mettrons cette page à jour dès que les
            reçus seront disponibles.
          </p>
        </div>
      </div>
    </section>

    <!-- ========== PARTENAIRES ========== -->
    <section class="partenaires">
      <div class="container">
        <div class="partenaires-grid">
          <div class="partenaires-text" data-animate>
            <span class="text-label">Devenir partenaire</span>
            <h2>Entreprises<br/>et organismes.</h2>
          </div>

          <div class="partenaires-content" data-animate data-delay="2">
            <p>
              Entreprises, fondations, organismes&#8239;: nous
              accueillons tous les soutiens, qu'il s'agisse de
              visibilité, de dons en biens et services ou d'un
              partenariat financier.
            </p>
            <p>
              Écrivez-nous pour discuter de la formule qui vous
              convient. Nous bâtirons un partenariat à votre image.
            </p>
            <a href="mailto:info@msespoir.ca?subject=Proposition%20de%20partenariat" class="link-underline">
              Proposer un partenariat
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ========== HERO ========== */
  .hero {
    position: relative;
    min-height: 55vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0;
    overflow: hidden;
  }

  .hero-visual {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    display: block;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(27, 58, 95, 0.3) 0%,
      rgba(27, 58, 95, 0.6) 50%,
      rgba(27, 58, 95, 0.9) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: clamp(3rem, 6vw, 6rem);
    padding-top: clamp(7rem, 12vh, 10rem);
    color: white;
    max-width: 1200px;
  }

  .hero-tagline {
    margin-bottom: 3rem;
  }

  .hero-tagline .text-label {
    color: #ffffff;
  }

  .hero h1 {
    color: #ffffff;
    margin-bottom: 4rem;
    font-weight: 300;
  }

  .hero-line {
    display: block;
  }

  .hero-accent {
    color: var(--color-accent);
    font-style: normal;
  }

  .hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .hero-description {
    max-width: 720px;
    font-size: 1rem;
    line-height: 1.8;
    color: #ffffff;
    margin: 0;
    font-weight: 300;
  }

  /* ========== PROMESSE ========== */
  .promesse {
    padding: clamp(8rem, 18vw, 14rem) 0;
    background: var(--color-white);
  }

  .promesse-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(4rem, 10vw, 10rem);
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(2rem, 6vw, 5rem);
  }

  .promesse-content {
    max-width: 480px;
  }

  .promesse-content .text-display em {
    font-style: italic;
  }

  .promesse-content .text-muted {
    font-size: 1rem;
    line-height: 1.75;
  }

  /* ========== MANIFESTE ========== */
  .manifeste {
    padding: clamp(10rem, 18vw, 16rem) 0;
    background: var(--color-sand);
  }

  .manifeste-quote {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4.5vw, 3rem);
    font-weight: 300;
    line-height: 1.4;
    color: var(--color-noir);
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    border: none;
    padding: 0;
    font-style: normal;
  }

  .manifeste-accent {
    font-style: normal;
    color: var(--color-marine);
    display: inline-block;
    margin-top: 1.25rem;
  }

  /* ========== MÉTHODES ========== */
  .methodes {
    padding: clamp(8rem, 15vw, 12rem) 0;
    background: var(--color-cream);
  }

  .methodes-header {
    margin-bottom: clamp(5rem, 10vw, 8rem);
    max-width: 500px;
  }

  .methodes-header .text-label {
    margin-bottom: 2rem;
    display: block;
  }

  .methodes-items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(3rem, 6vw, 6rem);
  }

  .methode-item {
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-sand);
    display: flex;
    flex-direction: column;
  }

  .methode-number {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 300;
    color: var(--color-gris-clair);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .methode-item h3 {
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    font-weight: 300;
  }

  .methode-item p {
    color: var(--color-gris);
    margin: 0 0 2rem 0;
    font-size: 1rem;
    line-height: 1.7;
    flex: 1;
  }

  .methode-item p strong {
    color: var(--color-noir);
    font-weight: 500;
  }

  .methode-item .link-underline {
    align-self: flex-start;
  }

  /* ========== REÇUS ========== */
  .recus {
    padding: clamp(8rem, 15vw, 12rem) 0;
    background: var(--color-ivory);
  }

  .recus-content {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 clamp(2rem, 6vw, 5rem);
  }

  .recus-content .text-label {
    margin-bottom: 2rem;
    display: block;
  }

  .recus-content h2 {
    margin-bottom: 3rem;
  }

  .recus-content .text-lead {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-noir);
    margin-bottom: 2rem;
  }

  .recus-content p {
    color: var(--color-gris);
    font-size: 1rem;
    line-height: 1.8;
  }

  /* ========== PARTENAIRES ========== */
  .partenaires {
    padding: clamp(8rem, 15vw, 12rem) 0;
    background: var(--color-white);
  }

  .partenaires-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(4rem, 10vw, 10rem);
    align-items: start;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(2rem, 6vw, 5rem);
  }

  .partenaires-text .text-label {
    margin-bottom: 2rem;
    display: block;
  }

  .partenaires-content p {
    color: var(--color-gris);
    margin: 0 0 1.5rem 0;
    line-height: 1.8;
  }

  .partenaires-content .link-underline {
    margin-top: 1rem;
    display: inline-block;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 1000px) {
    .promesse-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .methodes-items {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .methode-item {
      padding: 2.5rem 0;
      border-top: none;
      border-bottom: 1px solid var(--color-sand);
    }

    .methode-item:first-child {
      border-top: 1px solid var(--color-sand);
    }

    .partenaires-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>

<script>
  const animatedElements = document.querySelectorAll('[data-animate]');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, {
    threshold: 0.15,
    rootMargin: '0px 0px -80px 0px'
  });

  animatedElements.forEach(el => observer.observe(el));
</script>
