---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Nous joindre — Mouvement solidaire eSPoir">
  <Header />

  <main>
    <!-- ========== HERO ========== -->
    <section class="hero">
      <div class="hero-visual">
        <div class="hero-image">
          <img src="/images/hero-contact.jpg" alt="" />
        </div>
        <div class="hero-overlay"></div>
      </div>

      <div class="hero-content">
        <div class="hero-tagline" data-animate data-delay="1">
          <span class="text-label">Nous joindre</span>
        </div>

        <h1 data-animate data-delay="2">
          <span class="hero-line">Faisons</span>
          <span class="hero-line hero-accent">connaissance.</span>
        </h1>

        <div class="hero-bottom" data-animate data-delay="3">
          <p class="hero-description">
            Bénévoles, partenaires, donateurs ou simples curieux : il y
            a plusieurs façons de soutenir la recherche sur la guérison
            de la sclérose en plaques. Écrivez-nous, on sera heureux
            de vous lire.
          </p>
        </div>
      </div>
    </section>

    <!-- ========== ENGAGE ========== -->
    <section class="engage">
      <div class="container">
        <header class="engage-header" data-animate>
          <span class="text-label">Comment nous joindre</span>
          <h2>Chaque geste<br/>fait avancer la recherche.</h2>
        </header>

        <div class="engage-items">
          <article class="engage-item" data-animate data-delay="1">
            <span class="engage-number">01</span>
            <h3>Devenir bénévole</h3>
            <p>
              Quelques heures par événement ou un engagement plus
              régulier&#8239;: votre temps peut faire la différence.
              Aidez-nous à organiser des activités-bénéfice qui
              rassemblent la communauté.
            </p>
            <a href="mailto:info@msespoir.org?subject=Devenir%20b%C3%A9n%C3%A9vole" class="link-underline">
              Écrire pour s'inscrire
            </a>
          </article>

          <article class="engage-item" data-animate data-delay="2">
            <span class="engage-number">02</span>
            <h3>Poser une question</h3>
            <p>
              Une question sur la recherche, une demande médiatique
              ou un commentaire sur le Mouvement&#8239;? Notre équipe
              est à votre écoute et répond personnellement à chaque
              courriel.
            </p>
            <a href="mailto:info@msespoir.org" class="link-underline">
              Nous écrire
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== COORDONNÉES ========== -->
    <section class="coordonnees">
      <div class="container">
        <div class="coordonnees-grid">
          <div class="coordonnees-text" data-animate>
            <span class="text-label">Nos coordonnées</span>
            <h2>Une équipe<br/>à votre écoute.</h2>
            <p>
              Le Mouvement solidaire eSPoir est porté par des bénévoles
              passionnés. Tous les courriels sont lus et reçoivent
              une réponse personnalisée, généralement sous 48 heures.
            </p>
          </div>

          <div class="coordonnees-details" data-animate data-delay="2">
            <div class="coord-block">
              <span class="text-label">Adresse</span>
              <p>
                243, boul. Brien, bureau 250<br/>
                Repentigny (Québec)&nbsp;&nbsp;J6A 6M4
              </p>
            </div>

            <div class="coord-block">
              <span class="text-label">Courriel</span>
              <a href="mailto:info@msespoir.org" class="link-underline">
                info@msespoir.org
              </a>
            </div>

            <div class="coord-block">
              <span class="text-label">Suivez-nous</span>
              <div class="social-links">
                <a href="#" aria-label="Facebook" class="link-underline">Facebook</a>
                <a href="#" aria-label="Instagram" class="link-underline">Instagram</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ========== HERO ========== */
  .hero {
    position: relative;
    min-height: 55vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0;
    overflow: hidden;
  }

  .hero-visual {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    display: block;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(27, 58, 95, 0.3) 0%,
      rgba(27, 58, 95, 0.6) 50%,
      rgba(27, 58, 95, 0.9) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: clamp(3rem, 6vw, 6rem);
    padding-top: clamp(7rem, 12vh, 10rem);
    color: white;
    max-width: 1200px;
  }

  .hero-tagline {
    margin-bottom: 3rem;
  }

  .hero-tagline .text-label {
    color: #ffffff;
  }

  .hero h1 {
    color: #ffffff;
    margin-bottom: 4rem;
    font-weight: 300;
  }

  .hero-line {
    display: block;
  }

  .hero-accent {
    color: var(--color-accent);
    font-style: italic;
  }

  .hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .hero-description {
    max-width: 720px;
    font-size: 1rem;
    line-height: 1.8;
    color: #ffffff;
    margin: 0;
    font-weight: 300;
  }

  /* ========== ENGAGE ========== */
  .engage {
    padding: clamp(8rem, 15vw, 12rem) 0;
    background: var(--color-white);
  }

  .engage-header {
    margin-bottom: clamp(5rem, 10vw, 8rem);
    max-width: 500px;
  }

  .engage-header .text-label {
    margin-bottom: 2rem;
    display: block;
  }

  .engage-items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(3rem, 6vw, 6rem);
  }

  .engage-item {
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-sand);
    display: flex;
    flex-direction: column;
  }

  .engage-number {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 300;
    color: var(--color-gris-clair);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .engage-item h3 {
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    font-weight: 300;
  }

  .engage-item p {
    color: var(--color-gris);
    margin: 0 0 2rem 0;
    font-size: 1rem;
    line-height: 1.7;
    flex: 1;
  }

  .engage-item .link-underline {
    align-self: flex-start;
  }

  /* ========== COORDONNÉES ========== */
  .coordonnees {
    padding: clamp(8rem, 15vw, 12rem) 0;
    background: var(--color-cream);
  }

  .coordonnees-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(5rem, 10vw, 10rem);
    align-items: start;
  }

  .coordonnees-text .text-label {
    margin-bottom: 2rem;
    display: block;
  }

  .coordonnees-text h2 {
    margin-bottom: 3rem;
  }

  .coordonnees-text p {
    color: var(--color-gris);
    margin: 0;
    max-width: 420px;
  }

  .coordonnees-details {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .coord-block .text-label {
    margin-bottom: 1.25rem;
    display: block;
  }

  .coord-block p {
    color: var(--color-charcoal);
    margin: 0;
    font-size: 1rem;
    line-height: 1.8;
  }

  .coord-block .link-underline {
    color: var(--color-charcoal);
    font-size: 1rem;
  }

  .social-links {
    display: flex;
    gap: 2rem;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 1000px) {
    .engage-items {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .engage-item {
      padding: 2.5rem 0;
      border-top: none;
      border-bottom: 1px solid var(--color-sand);
    }

    .engage-item:first-child {
      border-top: 1px solid var(--color-sand);
    }

    .coordonnees-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }
</style>

<script>
  const animatedElements = document.querySelectorAll('[data-animate]');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, {
    threshold: 0.15,
    rootMargin: '0px 0px -80px 0px'
  });

  animatedElements.forEach(el => observer.observe(el));
</script>
