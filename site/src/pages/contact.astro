---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Nous joindre — Mouvement solidaire eSPoir"
  description="Bénévole, partenaire ou donateur : écrivez au Mouvement solidaire eSPoir à Repentigny. Une équipe bénévole à votre écoute, réponse sous 48 heures."
  preloadImage="/images/hero-contact.jpg">
  <Header />

  <main id="contenu">
    <PageHero
      image="/images/hero-contact.jpg"
      label="Nous joindre"
      lines={['Faisons', '<em>connaissance.</em>']}
      description="Bénévoles, partenaires, donateurs ou simples curieux&#8239;: il y a plusieurs façons de soutenir la recherche sur la guérison de la sclérose en plaques. Écrivez-nous, on sera heureux de vous lire."
    />

    <!-- ========== ENGAGE ========== -->
    <section class="engage">
      <div class="container">
        <header class="section-head engage-head" data-animate>
          <span class="text-label">Comment nous joindre</span>
          <h2>Chaque geste<br/>fait avancer la recherche.</h2>
        </header>

        <div class="engage-items">
          <article class="engage-card" data-animate data-delay="1">
            <span class="num-index">01</span>
            <h3>Devenir bénévole</h3>
            <p>
              Vous avez du temps ou des talents à offrir&#8239;?
              Joignez-vous au Mouvement&#8239;! Notre principe de
              base&#8239;: agir dans le plaisir, sans obligations&#8239;!
              Information&#8239;: info@msespoir.ca.
            </p>
            <a href="mailto:info@msespoir.ca?subject=Devenir%20b%C3%A9n%C3%A9vole" class="link-underline">
              Écrire pour s'inscrire
              <span class="arrow">→</span>
            </a>
          </article>

          <article class="engage-card" data-animate data-delay="2">
            <span class="num-index">02</span>
            <h3>Poser une question</h3>
            <p>
              Une question sur la recherche, une demande médiatique
              ou un commentaire sur le Mouvement&#8239;? Notre équipe
              est à votre écoute et répond personnellement à chaque
              courriel.
            </p>
            <a href="mailto:info@msespoir.ca" class="link-underline">
              Nous écrire
              <span class="arrow">→</span>
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== COORDONNÉES ========== -->
    <section class="coordonnees">
      <div class="container">
        <div class="coordonnees-grid">
          <div class="coordonnees-text" data-animate>
            <span class="text-label">Nos coordonnées</span>
            <h2>Une équipe<br/>à votre écoute.</h2>
            <p>
              Le Mouvement solidaire eSPoir est porté par des bénévoles
              passionnés. Tous les courriels sont lus et reçoivent
              une réponse personnalisée, généralement sous 48 heures.
            </p>
          </div>

          <div class="coordonnees-details" data-animate data-delay="2">
            <div class="coord-block">
              <span class="coord-label">Adresse</span>
              <p>
                243, boul. Brien, bureau 250<br/>
                Repentigny (Québec)&nbsp;&nbsp;J6A 6M4
              </p>
            </div>

            <div class="coord-block">
              <span class="coord-label">Courriel</span>
              <a href="mailto:info@msespoir.ca" class="link-underline coord-link">
                info@msespoir.ca
              </a>
            </div>

            <div class="coord-block">
              <span class="coord-label">Suivez-nous</span>
              <div class="social-links">
                <a href="#" aria-label="Facebook" class="link-underline">Facebook</a>
                <a href="#" aria-label="Instagram" class="link-underline">Instagram</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ========== ENGAGE ========== */
  .engage {
    padding: var(--section-y) 0;
    background: var(--color-white);
  }

  .engage-head { margin-bottom: clamp(4rem, 8vw, 6rem); }

  .engage-items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .engage-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 4vw, 3.25rem);
    background: var(--color-ivory);
    border: 1px solid var(--color-line);
    transition: transform 0.7s var(--ease-elegant), box-shadow 0.7s var(--ease-elegant), border-color 0.5s, background 0.5s;
  }

  .engage-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3rem;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.9s var(--ease-elegant);
  }

  .engage-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
    border-color: var(--color-accent-soft);
    background: var(--color-white);
  }

  .engage-card:hover::before { width: 100%; }

  .engage-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    font-weight: 400;
  }

  .engage-card p {
    color: var(--color-gris);
    margin: 0 0 2rem 0;
    font-size: 1rem;
    line-height: 1.75;
    flex: 1;
  }

  .engage-card .link-underline { align-self: flex-start; }

  /* ========== COORDONNÉES ========== */
  .coordonnees {
    padding: var(--section-y) 0;
    background: var(--color-cream);
    overflow: hidden;
  }

  .coordonnees::before {
    content: '';
    position: absolute;
    right: -10%;
    bottom: -30%;
    width: 55vw;
    height: 55vw;
    max-width: 720px;
    max-height: 720px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(79, 163, 214, 0.16), rgba(79, 163, 214, 0) 65%);
    pointer-events: none;
  }

  .coordonnees-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(4rem, 9vw, 9rem);
    align-items: start;
  }

  .coordonnees-text .text-label { margin-bottom: 1.75rem; }
  .coordonnees-text h2 { margin-bottom: 2.5rem; }

  .coordonnees-text p {
    color: var(--color-gris);
    margin: 0;
    max-width: 440px;
  }

  .coordonnees-details {
    display: flex;
    flex-direction: column;
  }

  .coord-block {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-line);
  }

  .coord-block:last-child { border-bottom: 1px solid var(--color-line); }

  .coord-label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-marine);
    padding-top: 0.3rem;
  }

  .coord-block p {
    color: var(--color-noir);
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .coord-link { font-size: 1.0625rem; }

  .social-links {
    display: flex;
    gap: 2rem;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 900px) {
    .engage-items { grid-template-columns: 1fr; }

    .coordonnees-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .coord-block {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
