---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page introuvable — Mouvement solidaire eSPoir"
  description="La page demandée n'existe pas ou a été déplacée.">
  <Header />

  <main id="contenu">
    <section class="notfound grain">
      <div class="notfound-glow" aria-hidden="true"></div>
      <span class="notfound-watermark" aria-hidden="true">404</span>

      <div class="container container-wide notfound-content">
        <p class="notfound-label"><span>Erreur 404</span></p>
        <h1 class="notfound-title">
          <span class="line" style="--i: 0"><span>Cette page</span></span>
          <span class="line" style="--i: 1"><span>n'existe <em>pas.</em></span></span>
        </h1>
        <p class="notfound-text">
          Le lien est peut-être erroné, ou la page a été déplacée.
          Le Mouvement, lui, continue d'avancer.
        </p>
        <div class="notfound-actions">
          <a href="/" class="btn btn-white">
            Retour à l'accueil
            <span class="btn-arrow">→</span>
          </a>
          <a href="/don" class="notfound-link">Faire un don</a>
          <a href="/contact" class="notfound-link">Nous joindre</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .notfound {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: linear-gradient(160deg, #1B3A5F 0%, #132A45 100%);
    color: white;
  }

  .notfound-glow {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 60vw;
    height: 60vw;
    max-width: 900px;
    max-height: 900px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(79, 163, 214, 0.32), rgba(79, 163, 214, 0) 62%);
    pointer-events: none;
  }

  .notfound-watermark {
    position: absolute;
    right: -0.05em;
    bottom: -0.25em;
    font-family: var(--font-heading);
    font-size: clamp(12rem, 40vw, 34rem);
    font-weight: 200;
    letter-spacing: -0.06em;
    line-height: 1;
    color: rgba(255, 255, 255, 0.04);
    pointer-events: none;
    user-select: none;
  }

  .notfound-content {
    position: relative;
    z-index: 2;
    padding-top: 8rem;
    padding-bottom: 5rem;
  }

  .notfound-label {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    margin: 0 0 2rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    opacity: 0;
    animation: fade 2s var(--ease-elegant) 0.3s forwards;
  }

  .notfound-label::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: var(--color-accent);
  }

  .notfound-title {
    color: white;
    margin: 0 0 2.5rem;
    max-width: 900px;
  }

  .notfound-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .notfound-title .line > span {
    display: block;
    transform: translateY(110%);
    animation: line-up 1.9s var(--ease-elegant) forwards;
    animation-delay: calc(0.45s + var(--i) * 0.2s);
  }

  .notfound-title em {
    font-style: normal;
    color: var(--color-accent);
  }

  .notfound-text {
    max-width: 480px;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.82);
    font-weight: 300;
    margin: 0 0 3rem;
    opacity: 0;
    animation: fade 2.2s var(--ease-elegant) 1.2s forwards;
  }

  .notfound-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem 2.5rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: fade 2.2s var(--ease-elegant) 1.6s forwards;
  }

  .notfound-link {
    position: relative;
    padding-bottom: 0.35rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    transition: color 0.4s, border-color 0.4s;
  }

  .notfound-link:hover {
    color: white;
    border-color: var(--color-accent);
  }

  @keyframes line-up { to { transform: translateY(0); } }
  @keyframes fade { to { opacity: 1; } }

  @media (max-width: 600px) {
    .notfound-actions { flex-direction: column; align-items: flex-start; }
    .notfound-actions .btn { width: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .notfound-title .line > span { transform: none; animation: none; }
    .notfound-label, .notfound-text, .notfound-actions { opacity: 1; animation: none; }
  }
</style>
