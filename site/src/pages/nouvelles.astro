---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Nouvelles — Mouvement solidaire eSPoir"
  description="Activités-bénéfice, jalons et avancées du Mouvement solidaire eSPoir : suivez les nouvelles de notre engagement pour la recherche sur la sclérose en plaques."
  preloadImage="/images/hero-home.jpg">
  <Header />

  <main id="contenu">
    <PageHero
      image="/images/hero-home.jpg"
      label="Nouvelles"
      lines={['Le Mouvement,', '<em>en mouvement.</em>']}
      description="Activités-bénéfice, jalons franchis, nouvelles de la cause&#8239;: suivez ici les avancées du Mouvement solidaire eSPoir et de notre engagement envers la recherche sur la guérison de la sclérose en plaques."
    />

    <!-- ========== À LA UNE ========== -->
    <section class="featured">
      <div class="container">
        <header class="section-head featured-head" data-animate>
          <span class="text-label">À la une</span>
        </header>

        <article class="featured-item">
          <div class="featured-photo frame-offset" data-animate="reveal">
            <div class="image-frame">
              <img src="/images/mc-parle.jpg" alt="Marie-Carole Daigle lors du premier souper-spectacle du Mouvement solidaire eSPoir" width="1600" height="1200" loading="lazy" decoding="async" />
            </div>
          </div>
          <div class="featured-text" data-animate data-delay="2">
            <div class="meta">
              <span class="meta-date">Novembre 2025</span>
              <span class="meta-cat">Activité-bénéfice</span>
            </div>
            <h2>Un premier souper-spectacle<br/>couronné de succès</h2>
            <p>
              Grâce à des dons en biens et services et à l'engagement
              du milieu, le Mouvement a offert un souper-spectacle à un
              prix très abordable. Une soirée portée par la solidarité,
              qui a permis de dégager un bénéfice de
              <strong>3 424&nbsp;$</strong> — entièrement consacré à la
              recherche.
            </p>
            <p>
              Un immense merci aux artistes, aux partenaires et à toutes
              les personnes présentes : vous avez transformé l'espoir en
              action.
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- ========== TOUTES LES NOUVELLES ========== -->
    <section class="nouvelles">
      <div class="container">
        <header class="section-head nouvelles-head" data-animate>
          <span class="text-label">Toutes les nouvelles</span>
          <h2>Les dernières<br/>avancées</h2>
        </header>

        <div class="nouvelles-list">
          <article class="nouvelle-item" data-animate data-delay="1">
            <div class="meta meta-col">
              <span class="meta-date">Octobre 2025</span>
              <span class="meta-cat">Annonce</span>
            </div>
            <div class="nouvelle-content">
              <h3>Le Mouvement solidaire eSPoir voit le jour</h3>
              <p>
                Marie-Carole Daigle et Hélène Collette fondent un
                organisme à but non lucratif avec une promesse claire :
                consacrer 100&#8239;% des revenus nets de nos
                activités-bénéfice à la recherche sur la guérison de la
                sclérose en plaques.
              </p>
            </div>
          </article>

          <article class="nouvelle-item" data-animate data-delay="2">
            <div class="meta meta-col">
              <span class="meta-date">2025</span>
              <span class="meta-cat">Jalon</span>
            </div>
            <div class="nouvelle-content">
              <h3>Trois ans de générosité grandissante</h3>
              <p>
                De 780&nbsp;$ en 2023 à plus de 2 800&nbsp;$ en 2025,
                la mobilisation autour de la cause n'a cessé de croître
                d'année en année — la preuve qu'ensemble, on peut aller
                encore plus loin.
              </p>
            </div>
          </article>

          <article class="nouvelle-item" data-animate data-delay="3">
            <div class="meta meta-col">
              <span class="meta-date">En cours</span>
              <span class="meta-cat">Reçus fiscaux</span>
            </div>
            <div class="nouvelle-content">
              <h3>Vers le statut d'organisme de bienfaisance</h3>
              <p>
                Le Mouvement est en démarches auprès de l'Agence du
                revenu du Canada pour obtenir le statut d'organisme de
                bienfaisance enregistré. Nous mettrons cette page à jour
                dès que les reçus officiels aux fins d'impôt seront
                disponibles.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== RESTEZ INFORMÉ ========== -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-content" data-animate>
          <span class="text-label suivez-label">Restez informé</span>
          <h2>Ne manquez<br/>aucune nouvelle.</h2>
          <p>
            Activités à venir, résultats, coulisses du Mouvement :
            suivez-nous sur les réseaux sociaux ou écrivez-nous pour
            recevoir nos prochaines annonces.
          </p>
          <div class="cta-buttons">
            <a href="#" class="link-underline">Facebook</a>
            <a href="#" class="link-underline">Instagram</a>
            <a href="mailto:info@msespoir.ca" class="link-underline">
              Nous écrire
              <span class="arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ========== À LA UNE ========== */
  .featured {
    padding: var(--section-y) 0;
    background: var(--color-white);
  }

  .featured-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }

  .featured-item {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .featured-photo .image-frame { aspect-ratio: 4/3; }

  .featured-text h2 {
    margin-bottom: 2rem;
    font-size: clamp(1.875rem, 3.4vw, 2.75rem);
  }

  .featured-text p {
    color: var(--color-gris);
    margin: 0 0 1.25rem 0;
    line-height: 1.8;
  }

  /* ========== META ========== */
  .meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .meta-date {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-marine);
  }

  .meta-cat {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-marine);
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
  }

  /* ========== TOUTES LES NOUVELLES ========== */
  .nouvelles {
    padding: var(--section-y) 0;
    background: var(--color-cream);
  }

  .nouvelles-head { margin-bottom: clamp(3.5rem, 7vw, 5rem); }

  .nouvelles-list {
    display: flex;
    flex-direction: column;
  }

  .nouvelle-item {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    padding: 2.75rem 0;
    border-bottom: 1px solid var(--color-line);
    transition: padding-left 0.6s var(--ease-elegant);
  }

  .nouvelle-item:first-child { border-top: 1px solid var(--color-line); }

  .meta-col {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
    margin: 0;
    padding-top: 0.35rem;
  }

  .nouvelle-content h3 {
    font-size: 1.375rem;
    margin-bottom: 0.875rem;
    font-weight: 400;
  }

  .nouvelle-content p {
    color: var(--color-gris);
    margin: 0;
    max-width: 580px;
    line-height: 1.8;
  }

  /* ========== RESTEZ INFORMÉ ========== */
  .suivez-label { margin-bottom: 1.75rem; }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 900px) {
    .featured-item {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .featured-photo .image-frame { aspect-ratio: 16/10; }

    .nouvelle-item {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .meta-col {
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
      padding-top: 0;
    }
  }
</style>
