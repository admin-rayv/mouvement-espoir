---
// Header — verre dépoli au défilement, logo blanc sur le hero, lien actif
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/histoire', label: 'Notre histoire' },
  { href: '/nouvelles', label: 'Nouvelles' },
  { href: '/activites', label: 'Activités' },
  { href: '/contact', label: 'Nous joindre' },
];

const isActive = (href: string) => path === href;
---

<header class="header" id="header">
  <div class="header-container">
    <a href="/" class="logo" aria-label="Mouvement solidaire eSPoir — Accueil">
      <img src="/images/logo-espoir.png" alt="Mouvement solidaire eSPoir" class="logo-img" width="140" height="140" />
    </a>

    <nav class="nav" aria-label="Navigation principale">
      <ul class="nav-list">
        {links.map((l) => (
          <li>
            <a href={l.href} class="nav-link" aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/don" class="btn btn-primary btn-donate">
      Faire un don
    </a>

    <button class="mobile-menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu grain" id="mobile-menu">
    <nav class="mobile-nav" aria-label="Navigation mobile">
      <ul class="mobile-nav-list">
        {links.map((l, i) => (
          <li style={`--i: ${i}`}>
            <a href={l.href} class="mobile-nav-link" aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-footer" style="--i: 4">
        <a href="/don" class="btn btn-white mobile-donate">Faire un don</a>
        <a href="mailto:info@msespoir.ca" class="mobile-email">info@msespoir.ca</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1.75rem 0;
    transition:
      padding 0.6s var(--ease-elegant),
      background-color 0.6s var(--ease-elegant),
      box-shadow 0.6s var(--ease-elegant),
      transform 0.6s var(--ease-elegant);
  }

  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10, 25, 40, 0.45), rgba(10, 25, 40, 0));
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.6s var(--ease-elegant);
  }

  .header.scrolled {
    background: rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    padding: 1rem 0;
    box-shadow: 0 1px 0 var(--color-line), 0 10px 30px -22px rgba(27, 58, 95, 0.35);
  }

  .header.scrolled::before { opacity: 0; }

  .header.is-hidden { transform: translateY(-100%); }

  .header-container {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .logo {
    display: flex;
    align-items: center;
    outline-offset: 6px;
  }

  .logo-img {
    height: 52px;
    width: auto;
    transition:
      height 0.6s var(--ease-elegant),
      filter 0.6s var(--ease-elegant),
      opacity 0.4s var(--ease-elegant);
  }

  /* Sur le hero sombre : logo en blanc */
  .header:not(.scrolled) .logo-img {
    filter: brightness(0) invert(1);
  }

  .header.scrolled .logo-img { height: 42px; }
  .logo:hover .logo-img { opacity: 0.75; }

  .nav-list {
    display: flex;
    gap: 2.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.35rem 0;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-noir);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    transition: color 0.4s var(--ease-elegant), opacity 0.4s var(--ease-elegant);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease-elegant);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-link[aria-current="page"]::after { opacity: 0.55; }

  .header:not(.scrolled) .nav-link { color: rgba(255, 255, 255, 0.92); }
  .nav-link:hover { opacity: 0.7; }

  .btn-donate {
    padding: 0.8rem 1.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
  }

  .header:not(.scrolled) .btn-donate {
    background: rgba(255, 255, 255, 0.08);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-color: rgba(255, 255, 255, 0.45);
    color: white;
  }

  .header:not(.scrolled) .btn-donate::before { display: none; }

  .header:not(.scrolled) .btn-donate:hover {
    background: white;
    color: var(--color-navy);
    border-color: white;
    box-shadow: 0 14px 34px -14px rgba(0, 0, 0, 0.5);
  }

  /* ---------- Menu mobile ---------- */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    width: 44px;
    height: 44px;
    position: relative;
    z-index: 2;
  }

  .mobile-menu-toggle span {
    display: block;
    width: 26px;
    height: 1px;
    background: var(--color-noir);
    transition: transform 0.5s var(--ease-elegant), background 0.4s;
  }

  .header:not(.scrolled) .mobile-menu-toggle span,
  .header.menu-open .mobile-menu-toggle span { background: white; }

  .mobile-menu-toggle.open span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .mobile-menu-toggle.open span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 85% 15%, rgba(79, 163, 214, 0.35), rgba(79, 163, 214, 0) 45%),
      linear-gradient(160deg, #1B3A5F 0%, #132A45 100%);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--ease-elegant), visibility 0.6s var(--ease-elegant);
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3.5rem;
    padding: 6rem var(--gutter) 3rem;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-list li,
  .mobile-footer {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s var(--ease-elegant), transform 0.7s var(--ease-elegant);
    transition-delay: calc(0.1s + var(--i) * 0.07s);
  }

  .mobile-menu.open .mobile-nav-list li,
  .mobile-menu.open .mobile-footer {
    opacity: 1;
    transform: none;
  }

  .mobile-nav-link {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 8vw, 2.75rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.5;
    color: white;
  }

  .mobile-nav-link[aria-current="page"] { color: var(--color-accent); }

  .mobile-footer {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .mobile-donate {
    width: auto;
    align-self: flex-start;
    padding: 1rem 2rem;
    font-size: 0.75rem;
  }

  .mobile-email {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .nav { display: none; }
    .btn-donate { display: none; }
    .mobile-menu-toggle { display: flex; }
    .mobile-menu { display: block; }
    .header { padding: 1.25rem 0; }
    .logo-img { height: 46px; }
  }
</style>

<script>
  function setMenuOpen(open: boolean) {
    const header = document.getElementById('header');
    const toggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    toggle?.classList.toggle('open', open);
    mobileMenu?.classList.toggle('open', open);
    header?.classList.toggle('menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }

  function initMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    if (!toggle || !mobileMenu) return;

    setMenuOpen(false);

    toggle.addEventListener('click', () => {
      setMenuOpen(!toggle.classList.contains('open'));
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenuOpen(false);
  });

  document.addEventListener('astro:page-load', initMenu);
  document.addEventListener('astro:before-swap', () => {
    document.documentElement.style.overflow = '';
  });
</script>
