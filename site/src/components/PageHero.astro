---
/**
 * PageHero — bandeau d'ouverture immersif.
 * Photo traitée en monochrome bleu nuit, révélation ligne par ligne,
 * léger zoom arrière au chargement, grain subtil.
 */
interface Props {
  /** Petit libellé au-dessus du titre (HTML accepté) */
  label: string;
  /** Lignes du titre (HTML accepté ; <em> = accent) */
  lines: string[];
  /** Paragraphe d'introduction (HTML accepté) */
  description?: string;
  /** Photo de fond (facultative : sans photo, fond bleu nuit) */
  image?: string;
  imagePosition?: string;
  /** Logo affiché en grand à gauche du texte (remplace la photo de fond) */
  logo?: string;
  /** Hero pleine hauteur (accueil) */
  tall?: boolean;
  /** Petites mentions en bas du hero (accueil) */
  meta?: string[];
}

const {
  label,
  lines,
  description,
  image,
  imagePosition = 'center',
  logo,
  tall = false,
  meta = [],
} = Astro.props;
---

<section class:list={['hero', 'grain', { 'hero-tall': tall, 'has-logo': logo }]}>
  <div class="hero-visual" aria-hidden="true">
    {image && (
      <div class="hero-image">
        <img
          src={image}
          alt=""
          style={`object-position: ${imagePosition}`}
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}
    <div class="hero-overlay"></div>
    <div class="hero-glow"></div>
  </div>

  <div class="hero-content container container-wide">
    <div class:list={[{ 'hero-main': logo }]}>
      {logo && (
        <div class="hero-logo" aria-hidden="true">
          <img src={logo} alt="" width="1200" height="1090" fetchpriority="high" decoding="async" />
        </div>
      )}

      <div class="hero-inner">
        <p class="hero-label"><span set:html={label} /></p>

        <h1 class="hero-title">
          {lines.map((line, i) => (
            <span class="hero-line" style={`--i: ${i}`}>
              <span class="hero-line-inner" set:html={line} />
            </span>
          ))}
        </h1>

        {description && (
          <div class="hero-bottom">
            <p class="hero-description" set:html={description} />
          </div>
        )}
      </div>
    </div>

    {(meta.length > 0 || tall) && (
      <div class="hero-foot">
        {meta.length > 0 && (
          <ul class="hero-meta">
            {meta.map((m) => <li set:html={m} />)}
          </ul>
        )}
        {tall && (
          <a href="#intro" class="hero-scroll" aria-label="Défiler vers le contenu">
            <span class="hero-scroll-text">Défiler</span>
            <span class="hero-scroll-line"></span>
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 62vh;
    min-height: 62svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: linear-gradient(160deg, #1B3A5F 0%, #132A45 100%);
    color: white;
  }

  .hero-tall {
    min-height: 100vh;
    min-height: 100svh;
  }

  .hero-visual {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.05) brightness(0.95);
    transform: scale(1.1);
    animation: hero-zoom 6s var(--ease-elegant) forwards;
  }

  @keyframes hero-zoom {
    to { transform: scale(1); }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(27, 58, 95, 0.35) 0%,
        rgba(27, 58, 95, 0.55) 45%,
        rgba(20, 44, 72, 0.9) 85%,
        rgba(16, 37, 62, 0.96) 100%
      );
  }

  .hero-glow {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 60vw;
    height: 60vw;
    max-width: 900px;
    max-height: 900px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(79, 163, 214, 0.32), rgba(79, 163, 214, 0) 62%);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: clamp(8rem, 16vh, 12rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .hero-inner { max-width: 1000px; }

  /* ---------- Variante logo : dessin en très grand à droite du texte ---------- */

  /* Fond enrichi : halos lumineux qui redonnent la profondeur du dégradé */
  .hero.has-logo {
    background:
      radial-gradient(ellipse 85% 75% at 74% 40%, rgba(79, 163, 214, 0.26), rgba(79, 163, 214, 0) 62%),
      radial-gradient(ellipse 70% 60% at 8% 10%, rgba(64, 108, 155, 0.55), rgba(64, 108, 155, 0) 65%),
      radial-gradient(ellipse 60% 50% at 90% 100%, rgba(23, 48, 78, 0.9), rgba(23, 48, 78, 0) 70%),
      linear-gradient(160deg, #1B3A5F 0%, #10243D 100%);
  }

  .hero-main {
    display: grid;
    grid-template-columns: 1fr minmax(300px, 700px);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .hero-main .hero-logo { order: 2; }

  .hero-logo {
    position: relative;
    /* Déborde légèrement du cadre : présence imposante */
    margin-right: clamp(-7rem, -5vw, -2rem);
  }

  /* Halo lumineux derrière le logo */
  .hero-logo::before {
    content: '';
    position: absolute;
    inset: -22%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(79, 163, 214, 0.38), rgba(79, 163, 214, 0) 62%);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .hero-logo img {
    position: relative;
    width: 100%;
    height: auto;
    opacity: 0;
    transform: scale(0.92) rotate(-4deg);
    animation:
      hero-fade 2s var(--ease-elegant) 0.3s forwards,
      hero-logo-in 2.6s var(--ease-elegant) 0.3s forwards;
    filter: drop-shadow(0 40px 80px rgba(0, 0, 0, 0.35));
  }

  @keyframes hero-logo-in {
    to { transform: scale(1) rotate(0deg); }
  }

  .hero-main .hero-title {
    font-size: clamp(2.25rem, 3.8vw, 3.5rem);
  }

  .hero-main .hero-description {
    font-size: clamp(0.9375rem, 1.1vw, 1.0625rem);
  }

  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    margin: 0 0 2rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    opacity: 0;
    animation: hero-fade 2s var(--ease-elegant) 0.3s forwards;
  }

  .hero-label::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: var(--color-accent);
  }

  .hero-label :global(.sp-emphasis) {
    font-size: 1.35em;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .hero-title {
    color: white;
    margin: 0;
    font-weight: 300;
  }

  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .hero-line-inner {
    display: block;
    transform: translateY(110%);
    animation: hero-line-up 1.9s var(--ease-elegant) forwards;
    animation-delay: calc(0.45s + var(--i) * 0.2s);
  }

  .hero-title :global(em) {
    font-style: normal;
    color: var(--color-accent);
  }

  .hero-bottom {
    margin-top: clamp(2.25rem, 4vw, 3.5rem);
    opacity: 0;
    animation: hero-fade 2.2s var(--ease-elegant) 1.3s forwards;
  }

  .hero-description {
    max-width: 640px;
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.86);
    margin: 0;
    font-weight: 300;
  }

  .hero-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    opacity: 0;
    animation: hero-fade 2.2s var(--ease-elegant) 1.8s forwards;
  }

  .hero-meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero-scroll {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.4s;
  }

  .hero-scroll:hover { color: white; }

  .hero-scroll-line {
    position: relative;
    display: block;
    width: 56px;
    height: 1px;
    background: rgba(255, 255, 255, 0.25);
    overflow: hidden;
  }

  .hero-scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: white;
    transform: translateX(-100%);
    animation: hero-scroll-sweep 3s var(--ease-elegant) infinite;
  }

  @keyframes hero-line-up {
    to { transform: translateY(0); }
  }

  @keyframes hero-fade {
    to { opacity: 1; }
  }

  @keyframes hero-scroll-sweep {
    0% { transform: translateX(-100%); }
    60%, 100% { transform: translateX(100%); }
  }

  @media (max-width: 900px) {
    .hero { min-height: 68svh; }
    .hero-tall { min-height: 100svh; }
    .hero-content { padding-top: clamp(7rem, 20vh, 10rem); }
    .hero-foot { flex-direction: column; align-items: flex-start; }
    .hero-scroll { display: none; }

    .hero-main {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero-main .hero-logo { order: -1; }
    .hero-logo {
      width: min(62vw, 320px);
      margin-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image img { transform: none; animation: none; }
    .hero-line-inner { transform: none; animation: none; }
    .hero-label, .hero-bottom, .hero-foot { opacity: 1; animation: none; }
    .hero-logo img { opacity: 1; transform: none; animation: none; }
    .hero-scroll-line::after { animation: none; }
  }
</style>
