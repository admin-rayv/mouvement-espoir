---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageHero from '../PageHero.astro';
import { type Lang } from '../../i18n/config';
import { privacyContent } from '../../i18n/content/confidentialite';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = privacyContent[lang];
---

<Layout
  title={c.title}
  description={c.description}
  breadcrumb={c.breadcrumb}
  lang={lang}
  routeKey="privacy">
  <Header lang={lang} routeKey="privacy" />

  <main id="contenu">
    <PageHero
      label={c.label}
      lines={c.lines}
      description={c.intro}
    />

    <section class="policy">
      <div class="container">
        <div class="policy-grid">
          <aside class="policy-aside" data-animate>
            <span class="text-label">{c.sommaire}</span>
            <nav class="policy-toc" aria-label={c.sommaireAria}>
              {c.sections.map((sec) => (
                <a href={`#${sec.id}`}>{sec.titre}</a>
              ))}
            </nav>
            <p class="policy-updated caption" set:html={c.maj} />
          </aside>

          <div class="policy-body" data-animate data-delay="1">
            <p class="text-lead" set:html={c.lead} />
            {c.sections.map((sec) => (
              <Fragment>
                <h2 id={sec.id} set:html={sec.titre} />
                <Fragment set:html={sec.corps} />
              </Fragment>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .policy {
    padding: var(--section-y) 0;
    background: var(--color-white);
  }

  .policy-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .policy-aside {
    position: sticky;
    top: 7rem;
  }

  .policy-aside .text-label { margin-bottom: 1.5rem; }

  .policy-toc {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line);
  }

  .policy-toc a {
    padding: 0.7rem 0;
    font-size: 0.9375rem;
    color: var(--color-gris);
    border-bottom: 1px solid var(--color-line);
    transition: color 0.4s, padding-left 0.5s var(--ease-elegant);
  }

  .policy-toc a:hover {
    color: var(--color-navy);
    padding-left: 0.5rem;
  }

  .policy-updated { margin: 1.75rem 0 0; }

  .policy-body { max-width: 680px; }

  .policy-body .text-lead { margin-bottom: 3rem; }
  .policy-body .text-lead em { font-style: italic; }

  .policy-body h2 {
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    font-weight: 400;
    margin: 3rem 0 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    scroll-margin-top: 7rem;
  }

  .policy-body p {
    color: var(--color-gris);
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }

  .policy-body ul {
    margin: 0 0 1.5rem;
    padding-left: 1.25rem;
    color: var(--color-gris);
    line-height: 1.8;
  }

  .policy-body li { margin-bottom: 0.5rem; }

  .policy-link {
    color: var(--color-navy);
    border-bottom: 1px solid var(--color-accent-soft);
    transition: border-color 0.4s;
  }

  .policy-link:hover { border-color: var(--color-navy); }

  @media (max-width: 900px) {
    .policy-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .policy-aside { position: static; }
  }
</style>
