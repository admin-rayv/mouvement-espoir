---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageHero from '../PageHero.astro';
import { path, type Lang } from '../../i18n/config';
import { faqContent } from '../../i18n/content/faq';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = faqContent[lang];

const toutes = c.groupes.flatMap((g) => g.questions);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang === 'fr' ? 'fr-CA' : 'en-CA',
  mainEntity: toutes.map((item) => ({
    '@type': 'Question',
    name: item.q.replace(/&#8239;/g, ' ').replace(/&nbsp;/g, ' '),
    acceptedAnswer: { '@type': 'Answer', text: item.texte },
  })),
};
---

<Layout
  title={c.title}
  description={c.description}
  breadcrumb={c.breadcrumb}
  schema={faqSchema}
  lang={lang}
  routeKey="faq">
  <Header lang={lang} routeKey="faq" />

  <main id="contenu">
    <PageHero label={c.label} lines={c.lines} description={c.intro} />

    <section class="faq">
      <div class="container">
        {c.groupes.map((groupe, gi) => (
          <div class="faq-groupe">
            <header class="section-head" data-animate>
              <span class="text-label">{groupe.groupe}</span>
            </header>

            <div class="faq-liste">
              {groupe.questions.map((item, i) => (
                <details class="faq-item" data-animate data-delay={String(Math.min(i + 1, 5))} open={gi === 0 && i === 0}>
                  <summary>
                    <h2 set:html={item.q} />
                    <span class="faq-icone" aria-hidden="true"></span>
                  </summary>
                  <div class="faq-reponse">
                    <p set:html={item.r} />
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))}

        <div class="faq-suite" data-animate>
          <p class="text-muted" set:html={c.suite} />
          <div class="cta-buttons">
            <a href={path('contact', lang)} class="btn btn-primary">
              {c.ctaContact}
              <span class="btn-arrow">→</span>
            </a>
            <a href={path('donate', lang)} class="link-underline">
              {c.ctaDon}
              <span class="arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .faq {
    padding: var(--section-y) 0;
    background: var(--color-white);
  }

  .faq-groupe { margin-bottom: clamp(3.5rem, 7vw, 5.5rem); }
  .faq-groupe .section-head { margin-bottom: 2rem; }

  .faq-liste {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line);
    max-width: 900px;
  }

  .faq-item { border-bottom: 1px solid var(--color-line); }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.75rem 0;
    cursor: pointer;
    list-style: none;
    transition: color 0.4s var(--ease-elegant);
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary h2 {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    font-weight: 400;
    line-height: 1.45;
    margin: 0;
    color: var(--color-noir);
    letter-spacing: -0.005em;
  }

  .faq-item summary:hover h2 { color: var(--color-navy); }

  .faq-icone {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .faq-icone::before,
  .faq-icone::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-marine);
    transition: transform 0.5s var(--ease-elegant);
  }

  .faq-icone::after { transform: rotate(90deg); }
  .faq-item[open] .faq-icone::after { transform: rotate(0deg); }

  .faq-reponse {
    padding: 0 0 1.75rem;
    max-width: 680px;
  }

  .faq-reponse p {
    margin: 0;
    color: var(--color-gris);
    line-height: 1.8;
  }

  .faq-suite {
    max-width: 560px;
    padding-top: 1rem;
  }

  .faq-suite p { margin-bottom: 2.25rem; }

  @media (max-width: 600px) {
    .faq-item summary { gap: 1.25rem; }
  }
</style>
